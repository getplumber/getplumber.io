# Form submissions (book a demo, newsletter) are emailed through Resend by the API routes
# in src/pages/api/. Leave these unset locally: the routes answer 503 and the forms show the
# email fallback instead.
RESEND_API_KEY=
RESEND_FROM=Plumber <hello@getplumber.io>
CONTACT_TO_EMAIL=hello@getplumber.io
