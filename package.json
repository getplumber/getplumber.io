{
  "name": "plumber",
  "type": "module",
  "version": "7.0.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "winsearch": "robocopy dist/pagefind public/pagefind /E",
    "osxsearch": "cp -r dist/pagefind public/",
    "start": "astro dev",
    "build": "astro build && pagefind --site .vercel/output/static",
    "preview": "astro preview",
    "astro": "astro",
    "config-i18n": "node ./scripts/config-i18n.js",
    "remove-keystatic": "node ./scripts/remove-keystatic.js",
    "seo-audit": "node ./scripts/seo-audit.js",
    "generate-favicon-ico": "node ./scripts/generate-favicon-ico.js",
    "format": "eslint . --fix && prettier -w \"**/*\" --ignore-unknown --cache",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.20",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@keystatic/astro": "6.0.0",
    "@keystatic/core": "0.6.9",
    "@pagefind/default-ui": "1.6.0",
    "@scalar/api-reference": "1.77.0",
    "@tabler/icons": "3.50.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.4.7",
    "astro-auto-import": "0.6.0",
    "astro-expressive-code": "^0.44.3",
    "astro-icon": "1.2.0",
    "astro-seo": "^1.2.0",
    "motion-on-scroll": "^1.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-variants": "^4.0.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.11",
    "@eslint/js": "10.0.1",
    "@playform/compress": "0.2.5",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "esbuild": "^0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.14.0",
    "lodash.debounce": "4.0.8",
    "lodash.throttle": "4.1.1",
    "pagefind": "1.6.0",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "semantic-release": "^25.0.9",
    "sharp-ico": "^0.1.5",
    "typescript-eslint": "8.72.1"
  },
  "//": "overrides note: @semantic-release/npm is stubbed with @semantic-release/error because this site never publishes to npm, the plugin is not in .releaserc.json, and its `npm` dependency bundles vulnerable tar/brace-expansion copies that overrides cannot patch. Remove the stub if npm publishing is ever needed.",
  "// conventional-changelog-conventionalcommits": "pinned to 10.2.1: 10.3+ needs conventional-changelog-writer@9, which @semantic-release/release-notes-generator (<= 14.x) does not ship, so semantic-release fails in generateNotes. Mirrors the Dependabot ignore in .github/dependabot.yml; lift both once release-notes-generator depends on writer 9.",
  "overrides": {
    "@expressive-code/core": {
      "postcss-nested": "^7.0.2"
    },
    "@semantic-release/npm": "npm:@semantic-release/error@^4.0.0",
    "sharp": "^0.35.4",
    "@playform/compress": {
      "svgo": "^4.0.2",
      "deepmerge-ts": "^8.0.2"
    },
    "chokidar": "^5.0.0",
    "lodash": "^4.17.22",
    "minimatch": "^11.0.1",
    "eslint": "10.14.0",
    "yaml": "^2.9.1",
    "devalue": "^6.0.2",
    "fast-xml-builder": "^1.2.0",
    "brace-expansion": "^5.0.9",
    "tar": "^7.5.22",
    "js-yaml": "^4.3.2",
    "vite": "^8.1.0",
    "@keystatic/astro": {
      "astro": "$astro"
    },
    "astro-auto-import": {
      "astro": "$astro"
    },
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    },
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "@vercel/nft": {
      "glob": "^14.0.2"
    }
  }
