{
  "name": "plumber",
  "type": "module",
  "version": "7.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "winsearch": "robocopy dist/pagefind public/pagefind /E",
    "osxsearch": "cp -r dist/pagefind public/",
    "start": "astro dev",
    "build": "astro build && pagefind --site .vercel/output/static",
    "preview": "astro preview",
    "astro": "astro",
    "config-i18n": "node ./scripts/config-i18n.js",
    "remove-keystatic": "node ./scripts/remove-keystatic.js",
    "seo-audit": "node ./scripts/seo-audit.js",
    "generate-favicon-ico": "node ./scripts/generate-favicon-ico.js",
    "format": "eslint . --fix && prettier -w \"**/*\" --ignore-unknown --cache",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.4",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@keystatic/astro": "5.2.0",
    "@keystatic/core": "0.6.4",
    "@pagefind/default-ui": "1.5.2",
    "@scalar/api-reference": "1.64.0",
    "@tabler/icons": "3.46.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.1.4",
    "astro-auto-import": "0.5.2",
    "astro-expressive-code": "^0.44.1",
    "astro-icon": "1.1.5",
    "astro-seo": "^1.1.0",
    "motion-on-scroll": "^1.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.10",
    "@eslint/js": "10.0.1",
    "@playform/compress": "0.2.3",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.8.0",
    "lodash.debounce": "4.0.8",
    "lodash.throttle": "4.1.1",
    "pagefind": "1.5.2",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "semantic-release": "^25.0.8",
    "sharp-ico": "^0.1.5",
    "typescript-eslint": "8.65.0"
  },
  "//": "overrides note: @semantic-release/npm is stubbed with @semantic-release/error because this site never publishes to npm, the plugin is not in .releaserc.json, and its `npm` dependency bundles vulnerable tar/brace-expansion copies that overrides cannot patch. Remove the stub if npm publishing is ever needed.",
  "overrides": {
    "@semantic-release/npm": "npm:@semantic-release/error@^4.0.0",
    "sharp": "^0.35.0",
    "@playform/compress": {
      "svgo": "^4.0.2"
    },
    "path-to-regexp": "^8.3.0",
    "chokidar": "^5.0.0",
    "lodash": "^4.17.22",
    "minimatch": "^10.2.1",
    "eslint": "10.8.0",
    "eslint-plugin-jsx-a11y": {
      "minimatch": "3.1.5"
    },
    "yaml": "2.8.3",
    "devalue": "^5.8.1",
    "fast-uri": "^3.1.5",
    "fast-xml-builder": "^1.2.0",
    "brace-expansion": "^5.0.9",
    "esbuild": "^0.28.1",
    "undici": "^7.28.0",
    "tar": "^7.5.22",
    "js-yaml": "^4.3.0",
    "@babel/core": "^7.29.7",
    "vite": "^8.1.0",
    "@keystatic/astro": {
      "astro": "$astro"
    },
    "astro-auto-import": {
      "astro": "$astro"
    }
  }
}
