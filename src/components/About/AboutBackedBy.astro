---
/**
 * "Backed by." (Figma About us, section "backed by", 280px under the team; Figma draws its
 * title 1px above the frame, hence 279px to the title here): the 62/112 uppercase title in
 * white and, 32px under it, the 38/110 paragraph on 869px in grey with the raise, the fund
 * and the angels in white. Figma draws this block 54px from the left edge; the page keeps
 * the 60px grid of every other section.
 */
import { aboutBackedBy as data } from "@config/en/aboutData.json";
---

<section
  class="home-container mt-[120px] lg:mt-[279px]"
  aria-labelledby="about-backed-title"
  data-reveal
>
  <h2 id="about-backed-title" class="h1 text-foreground uppercase">
    {data.title}
  </h2>
  <p class="h2 text-muted-foreground mt-8 max-w-[869px]">
    {data.runs.map((run) =>
      run.accent ? <span class="text-foreground">{run.text}</span> : run.text,
    )}
  </p>
</section>
