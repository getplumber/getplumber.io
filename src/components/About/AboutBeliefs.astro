---
/**
 * "What we believe" (Figma About us, frame 1000001783, new design of 2026-11-25): a full
 * width accent band (#09C3C3, 140px above and under its content) with, in #0C0C0C, the pixel
 * eyebrow, 24px, the 62/112 Regular title on the full width, 56px, and the 18/150 paragraph
 * on 973px pushed 338px to the right. 140px under the band the four rules: 312 x 310 cards
 * spread over the row (narrower, 24px apart, when the row is short of 1320px), each on the
 * 4 x 4 accent dashed stroke and 32px from it (the 4px stroke plus 28px of padding): the
 * 92px pixel number, 24px, the 18/110 Regular title, 24px, the 16/24 text on 280px, or, for
 * the last card, the "View on GitHub" chevron link under it. Below lg the cards go two then
 * one per row.
 */
import { aboutBeliefs as data } from "@config/en/aboutData.json";
import { Icon } from "astro-icon/components";
---

<section class="mt-[120px] lg:mt-[280px]" aria-labelledby="about-beliefs-title">
  <div class="about-band section-y">
    <div class="home-container flex flex-col gap-6" data-reveal>
      <p class="eyebrow about-band__eyebrow flex items-center gap-2 py-1.5">
        <span class="about-band__dot" aria-hidden="true"></span>
        {data.eyebrow}
      </p>
      <div class="flex flex-col gap-8 lg:gap-14">
        <h2 id="about-beliefs-title" class="h1 about-band__title uppercase">
          {data.title}
        </h2>
        <p class="body-lg about-band__text max-w-[973px] lg:ml-[338px]">{data.text}</p>
      </div>
    </div>
  </div>

  <ol
    class="home-container mt-20 grid gap-10 md:grid-cols-2 lg:mt-[140px] lg:grid-cols-[repeat(4,minmax(0,312px))] lg:justify-between lg:gap-6"
    data-reveal-stagger
    style="--reveal-step: 700ms; --reveal-duration: 1700ms;"
  >
    {data.rules.map((rule) => (
      <li class="about-rule dash-l dash-accent flex flex-col gap-6 pl-7 lg:min-h-[310px]">
        <span class="about-rule__number text-primary-500">{rule.number}</span>
        <div class="flex max-w-[280px] flex-col gap-6 pb-6">
          <h3 class="about-rule__title text-foreground">{rule.title}</h3>
          <p class="text-muted-foreground text-base leading-6">{rule.text}</p>
          {rule.link && (
            <a
              href={rule.link.href}
              class="link-arrow self-start text-base"
              target="_blank"
              rel="noopener noreferrer"
              data-track-event={rule.link.track}
              data-track-placement="about"
            >
              <span>{rule.link.text}</span>
              <Icon name="pixel/chevron" aria-hidden="true" />
            </a>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .about-band {
    background-color: var(--color-primary-500);
  }
  .about-band__eyebrow,
  .about-band__title,
  .about-band__text {
    color: var(--color-base-950);
  }
  .about-band__dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    flex: none;
    background-color: var(--color-base-950);
  }
  .about-rule__number {
    font-family: var(--font-pixel);
    font-size: 5.75rem;
    line-height: 0.8;
    line-height: round(0.8em, 1px);
    letter-spacing: 0.02em;
  }
  .about-rule__title {
    font-size: 1.125rem;
    line-height: 1.1;
    line-height: round(1.1em, 1px);
    font-weight: 400;
  }
</style>
