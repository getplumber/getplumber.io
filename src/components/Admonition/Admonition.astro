---
/**
 * Blog note banner, same design as the docs Aside: 8px radius, tint fill, 22px icon and a
 * medium title. tip and info are teal, caution amber, danger red.
 */
import { Icon } from "astro-icon/components";

interface Props {
  variant: "tip" | "caution" | "danger" | "info";
  title?: string;
}

const { variant, title } = Astro.props as Props;

const icon = (() => {
  switch (variant) {
    case "tip":
      return "tabler/bulb";
    case "caution":
      return "tabler/alert-triangle";
    case "danger":
      return "tabler/flame";
    case "info":
      return "tabler/info-circle";
  }
})();
---

<div
  class:list={[
    "admonition text-foreground rounded-r8 my-6 border px-6 py-4",
    {
      "border-accent-20 bg-primary-500/5 admonition-success": variant === "tip",
      "border-warning/40 bg-warning/5 admonition-warning": variant === "caution",
      "border-danger-25 bg-danger-5 admonition-error": variant === "danger",
      "border-accent-20 bg-primary-500/5 admonition-info": variant === "info",
    },
  ]}
>
  <div class="not-content flex items-center gap-3 pb-2">
    <Icon
      name={icon}
      class:list={[
        "size-[22px] shrink-0",
        {
          "text-primary-500": variant === "tip" || variant === "info",
          "text-warning": variant === "caution",
          "text-danger-500": variant === "danger",
        },
      ]}
    />
    <p class="subtitle text-foreground">
      {title || variant.charAt(0).toUpperCase() + variant.slice(1)}
    </p>
  </div>
  <slot />
</div>

<style is:global>
  .admonition > :first-child {
    margin-top: 0;
  }
  .admonition > :nth-child(2) {
    margin-top: 0;
  }
  .admonition > :last-child {
    margin-bottom: 0;
  }
  .admonition code {
    background-color: var(--color-tint-10);
    border-color: var(--color-tint-25);
  }
</style>
