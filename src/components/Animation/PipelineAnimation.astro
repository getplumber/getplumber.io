      const ctrlSep = cy("├" + "─".repeat(NAME_W + 2) + "┼" + "─".repeat(22) + "┼" + "─".repeat(12) + "┼" + "─".repeat(4) + "┤");
      const ctrlBot = cy("╰" + "─".repeat(NAME_W + 2) + "┴" + "─".repeat(22) + "┴" + "─".repeat(12) + "┴" + "─".repeat(4) + "╯");
      o += "  " + bd("Controls") + "\n";
      o += "  " + ctrlTop + "\n";
      o += "  " + cy("│") + ` ${"Control".padEnd(NAME_W)} ` + cy("│") + ` ${"Codes".padEnd(20)} ` + cy("│") + ` ${"Severity".padEnd(10)} ` + cy("│") + ` ${"#".padEnd(2)} ` + cy("│") + "\n";
      o += "  " + ctrlSep + "\n";

      const ctrlRows: [string, string, string, number][] = [
        ["Branch must be protected", "ISSUE-501, ISSUE-505", "Critical", 4],
        ["Security jobs must not be weakened", "ISSUE-410", "Critical", 2],
        ["Container images must not use forbidden tags (pinned by digest)", "ISSUE-102, ISSUE-103", "High", 19],
        ["Pipeline must not use Docker-in-Docker", "ISSUE-412, ISSUE-413", "High", 3],
        ["Container images must come from authorized sources", "ISSUE-101", "High", 1],
        ["Pipeline must not execute unverified scripts", "ISSUE-411", "High", 1],
        ["Pipeline must not override job variables", "ISSUE-205", "High", 1],
        ["Pipeline must not include hardcoded jobs", "ISSUE-401", "Medium", 5],
        ["Pipeline must include required components", "ISSUE-409", "Medium", 1],
        ["Pipeline must not use unsafe variable expansion", "ISSUE-204", "Medium", 1],
        ["Includes must be up to date", "ISSUE-403", "Low", 2],
      ];

      ctrlRows.forEach(([name, codes, severity, count]) => {
        const n = name.padEnd(NAME_W);
        const c = codes.padEnd(20);
        const s = sevTableCell(severity);
        const num = cl(String(count).padEnd(2), "text-red-400");
        o += "  " + cy("│") + ` ${n} ` + cy("│") + ` ${c} ` + cy("│") + ` ${s} ` + cy("│") + ` ${num} ` + cy("│") + "\n";
      });

      o += "  " + ctrlBot + "\n";
      o += "  " + dm("↳ docs: https://getplumber.io/docs/cli/issues/&lt;code&gt;") + "\n\n";

      // Plumber Score banner
      const longDivider = dm(" ──────────────────────────────────────────────────────────────────────────────");
      o += "\n" + longDivider + "\n";
      o += " " + bd("Plumber Score") + "\n\n";

      const scoreE = (s: string) => cl(s, "text-red-400");
      o += " " + scoreE("███████╗") + "\n";
      o += " " + scoreE("██╔════╝") + "  " + cl("0 / 100 pts", "text-red-400") + "\n";
      o += " " + scoreE("█████╗  ") + "  " + dm("░░░░░░░░░░░░░░░░░░░░░░░░░░░░") + "\n";
      o += " " + scoreE("██╔══╝  ") + "  " + cl("Critical", "text-red-400") + " — at least one Critical issue or heavy accumulated losses\n";
      o += " " + scoreE("███████╗") + "\n";
      o += " " + scoreE("╚══════╝") + "  🔴 Critical 5   🟠 High 25   🟡 Medium 8   🔵 Low 2\n\n";

      o += longDivider + "\n";

      return o;
    }

    // Mobile output: compact layout adapted for small screens
    function getMobileOutputLines(): string[] {
      const lines: string[] = [];

      const controlsData: [string, string, string, number][] = [
        ["Branch must be protected", "ISSUE-501, ISSUE-505", "Critical", 4],
        ["Security jobs must not be weakened", "ISSUE-410", "Critical", 2],
        ["Container images must not use forbidden tags (pinned by digest)", "ISSUE-102, ISSUE-103", "High", 19],
        ["Pipeline must not use Docker-in-Docker", "ISSUE-412, ISSUE-413", "High", 3],
        ["Container images must come from authorized sources", "ISSUE-101", "High", 1],
        ["Pipeline must not execute unverified scripts", "ISSUE-411", "High", 1],
        ["Pipeline must not override job variables", "ISSUE-205", "High", 1],
        ["Pipeline must not include hardcoded jobs", "ISSUE-401", "Medium", 5],
        ["Pipeline must include required components", "ISSUE-409", "Medium", 1],
        ["Pipeline must not use unsafe variable expansion", "ISSUE-204", "Medium", 1],
        ["Includes must be up to date", "ISSUE-403", "Low", 2],
      ];

      function mobileSevBadge(sev: string): string {
        const map: Record<string, [string, string]> = {
          Critical: ["bg-red-500 text-white", "Critical"],
          High: ["bg-yellow-500 text-black", "High"],
          Medium: ["bg-cyan-700 text-white", "Medium"],
          Low: ["bg-blue-700 text-white", "Low"],
        };
        const entry = map[sev];
        if (!entry) return sev;
        return `<span class="${entry[0]} text-[10px] px-1 rounded leading-tight">${entry[1]}</span>`;
      }

      // Status + score gate + critical codes
      lines.push(
        '<div class="space-y-4">' +
          '<div class="pb-2 border-b border-base-600/30">' +
          '<div class="flex items-center gap-2">' +
          '<span class="text-base-400">Status:</span>' +
          '<span class="text-red-400 font-semibold inline-flex items-center gap-1">FAILED' +
          CLI_STATUS_SVG_FAIL +
          "</span>" +
          '<span class="text-base-500 text-xs">score E — 0.0/100 pts</span>' +
          "</div>" +
          '<div class="flex flex-col gap-0.5 mt-1">' +
          '<div class="flex items-center gap-2">' +
          '<span class="text-red-400 text-xs">Critical:</span>' +
          '<span class="text-base-300 text-xs">ISSUE-410, ISSUE-501</span>' +
          "</div>" +
          "</div></div>",
      );

      // Passed / skipped counts (compact stand-in for the desktop group sections)
      lines.push(
        '<div class="flex flex-wrap gap-x-3 gap-y-0.5 text-xs">' +
          '<span class="text-green-400">✓ Passed 2</span>' +
          '<span class="text-base-500">• Skipped 2</span>' +
          '<span class="text-red-400">✗ Failed 11</span>' +
          "</div>",
      );

      // Failed controls section header
      lines.push(
        '<div><h3 class="text-base-400 font-semibold mb-2">Failed Controls (11)</h3><div class="space-y-1.5">',
      );

      // Controls rows (one per line for typing effect)
      controlsData.forEach(([name, , severity, count]) => {
        lines.push(
          '<div class="flex justify-between items-center gap-2">' +
            `<span class="text-base-300 text-xs min-w-0">${name}</span>` +
            '<div class="flex items-center gap-1.5 shrink-0">' +
            mobileSevBadge(severity) +
            `<span class="text-red-400 text-xs w-4 text-right tabular-nums">${count}</span>` +
            "</div></div>",
        );
      });

      // Close Failed Controls, then Plumber Score + close wrappers
      lines.push("</div></div>");
      lines.push(
        '<div class="pt-2 border-t border-base-600/30">' +
          '<h3 class="text-base-400 font-semibold mb-2">Plumber Score</h3>' +
          '<div class="flex items-center gap-3">' +
          '<span class="text-red-400 font-mono text-6xl font-bold leading-none">E</span>' +
          "<div>" +
          '<div class="text-red-400 text-xs font-semibold">0 / 100 pts</div>' +
          '<div class="text-red-400 text-xs">Critical — at least one Critical issue</div>' +
          "</div>" +
          "</div>" +
          '<div class="flex flex-wrap gap-2 mt-1.5 text-xs">' +
          "<span>🔴 Critical 5</span>" +
          "<span>🟠 High 25</span>" +
          "<span>🟡 Medium 8</span>" +
          "<span>🔵 Low 2</span>" +
          "</div>" +
          "</div>" +
          "</div>",
      );

      return lines;
    }

    function generateMobileOutput(): string {
      return getMobileOutputLines().join("");
    }

    // Function to type CLI output line by line (desktop + mobile both line-by-line)
    function typeCliOutput() {
      const cliOutput = root.querySelector<HTMLElement>("#cli-output");
      const cliOutputMobile = root.querySelector<HTMLElement>("#cli-output-mobile");
      const mobileScrollContainer = cliOutputMobile?.parentElement;

      const fullOutput = generateCliOutput();
      const desktopLines = fullOutput.split("\n");
      const mobileLines = getMobileOutputLines();

      let desktopContent = "";
      let desktopIndex = 0;
      let mobileContent = "";
      let mobileIndex = 0;

      function scrollDesktopToBottom() {
        const preElement = cliOutput?.parentElement;
        const scrollContainer = preElement?.parentElement;
        if (scrollContainer) {
          scrollContainer.scrollTop = scrollContainer.scrollHeight;
        }
      }

      function updateMobileAndScroll() {
        if (cliOutputMobile) {
          cliOutputMobile.innerHTML = mobileContent;
          if (mobileScrollContainer) {
            mobileScrollContainer.scrollTop = mobileScrollContainer.scrollHeight;
          }
        }
      }

      function tick() {
        if (desktopIndex < desktopLines.length) {
          desktopContent += desktopLines[desktopIndex] + "\n";
          if (cliOutput) cliOutput.innerHTML = desktopContent;
          scrollDesktopToBottom();
          desktopIndex++;
        }
        if (mobileIndex < mobileLines.length) {
          mobileContent += mobileLines[mobileIndex];
          updateMobileAndScroll();
          mobileIndex++;
        }
        if (desktopIndex < desktopLines.length || mobileIndex < mobileLines.length) {
          schedule(tick, 40); // Compliance results line typing / scroll cadence
        }
      }

      tick();
    }

    // Handle warning icon click
    if (warningIcon) {
      warningIcon.addEventListener("click", () => {
        pipelineCompleteStage.classList.add("hidden");
        resultsStage.classList.remove("hidden");

        // Clear previous output and start typing animation
        schedule(() => {
          const cliOutput = root.querySelector<HTMLElement>("#cli-output");
          const cliOutputMobile = root.querySelector<HTMLElement>("#cli-output-mobile");
          if (cliOutput) {
            cliOutput.innerHTML = "";
          }
          if (cliOutputMobile) {
            cliOutputMobile.innerHTML = "";
          }
          typeCliOutput();
        }, 100);
      });
    }

    // Start the animation
    typeCode();
  }

  const GLOBAL_KEY = "__pipelineAnimationGlobalBound__";
  const globalAny = globalThis as unknown as Record<string, unknown>;

  if (!globalAny[GLOBAL_KEY]) {
    globalAny[GLOBAL_KEY] = true;

    // Start / re-init on initial load and on view transitions
    document.addEventListener("DOMContentLoaded", initAllPipelineAnimations);
    document.addEventListener("astro:after-swap", initAllPipelineAnimations);

    // Handle window resize to keep scroll at bottom (only bind once)
    let resizeTimeout: any;
    window.addEventListener("resize", () => {
      if (resizeTimeout) window.clearTimeout(resizeTimeout);
      resizeTimeout = window.setTimeout(() => {
        document.querySelectorAll<HTMLElement>("[data-pipeline-animation-root]").forEach((root) => {
          const resultsStage = root.querySelector<HTMLElement>("#results-stage");
          if (resultsStage && !resultsStage.classList.contains("hidden")) {
            // Scroll desktop version to bottom
            const cliOutput = root.querySelector<HTMLElement>("#cli-output");
            if (cliOutput) {
              const preElement = cliOutput.parentElement;
              const scrollContainer = preElement?.parentElement;
              if (scrollContainer) scrollContainer.scrollTop = scrollContainer.scrollHeight;
            }

            // Scroll mobile version to bottom
            const cliOutputMobile = root.querySelector<HTMLElement>("#cli-output-mobile");
            if (cliOutputMobile && cliOutputMobile.parentElement) {
              cliOutputMobile.parentElement.scrollTop = cliOutputMobile.parentElement.scrollHeight;
            }
          }
        });
      }, 100); // Debounce resize events
    });
  }

  // Run once for the currently-rendered page
  initAllPipelineAnimations();
</script>

