      issueAt("HIGH", "ISSUE-103", ['job "gemnasium-python-dependency_scanning" uses image without digest pinning:', "registry.gitlab.com/security-products/gemnasium-python:6$DS_IMAGE_SUFFIX"], 65);
      issueAt("HIGH", "ISSUE-103", ['job "gitlab-advanced-sast" uses image without digest pinning:', "registry.gitlab.com/security-products/gitlab-advanced-sast:2"], 54);
      issueAt("HIGH", "ISSUE-103", ['job "gitlab-advanced-sast-cpp" uses image without digest pinning:', "registry.gitlab.com/security-products/clangsa:1"], 54);
      issueAt("HIGH", "ISSUE-103", ['job "kubesec-sast" uses image without digest pinning:', "registry.gitlab.com/security-products/kubesec:6"], 54);
      issueAt("HIGH", "ISSUE-103", 'job "lint" uses image without digest pinning: docker.io/golangci/golangci-lint:latest', 45);
      issueAt("HIGH", "ISSUE-103", ['job "pmd-apex-sast" uses image without digest pinning:', "registry.gitlab.com/security-products/pmd-apex:6"], 54);
      issueAt("HIGH", "ISSUE-103", ['job "secret_detection" uses image without digest pinning:', "registry.gitlab.com/security-products/secrets:7"], 68);
      issueAt("HIGH", "ISSUE-103", ['job "semgrep-sast" uses image without digest pinning:', "registry.gitlab.com/security-products/semgrep:6"], 54);
      issueAt("HIGH", "ISSUE-103", ['job "sobelow-sast" uses image without digest pinning:', "registry.gitlab.com/security-products/sobelow:6"], 54);
      issueAt("HIGH", "ISSUE-103", ['job "spotbugs-sast" uses image without digest pinning:', "registry.gitlab.com/security-products/spotbugs:5"], 54);
      issueAt("HIGH", "ISSUE-103", 'job "test" uses image without digest pinning: docker.io/golang:1.22', 33);
      o += "\n";

      failedHead("Security jobs must not be weakened", 2);
      stat("Security Jobs Found", "20");
      stat("Weakened Jobs", "2");
      issuesHdr();
      issueAt("CRIT", "ISSUE-410", ['security job "secret_detection" is weakened:', "rules overridden with 'when: manual', job will not run"], 68);
      issueAt("CRIT", "ISSUE-410", ['security job "secret_detection" is weakened:', "when: manual prevents the scan from running automatically"], 68);
      o += "\n";

      failedHead("Branch must be protected", 4);
      stat("Total Branches", "7");
      stat("Branches to Protect", "4");
      stat("Protected Branches", "1");
      stat("Unprotected", "3");
      stat("Non-Compliant", "1");
      issuesHdr();
      issueSub("HIGH", "ISSUE-505", "Branch 'main' has non-compliant protection settings", "Force push is allowed (should be disabled)");
      issue("CRIT", "ISSUE-501", 'branch "dev" must be protected');
      issue("CRIT", "ISSUE-501", 'branch "master" must be protected');
      issue("CRIT", "ISSUE-501", 'branch "production" must be protected');
      o += "\n";

      // Summary
      o += dm("────────────────────") + "\n";
      o += bd("Summary") + "\n";
      o += dm("────────────────────") + "\n\n";

      o += "  " + cl("▶ Critical issue codes:", "text-red-400") + " ISSUE-410, ISSUE-501\n\n";
      o +=
        "  Status: " +
