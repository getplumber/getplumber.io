        " " +
        dm("(score E — 0.0/100 pts, required ≥ 100 pts)") +
        "\n\n";

      // Controls table — column widths follow the real CLI output (longest
      // control name is 63 chars, so the name column is 63 + padding)
      const NAME_W = 63;
