---
import type { HTMLAttributes } from "astro/types";

/**
 * Figma button component.
 * Pass "href" to render a link (<a>), or "type" to render a <button>.
 * Variants: primary (accent fill, marker after), secondary (stroke, marker before),
 * secondary-trailing (stroke, marker after), ghost (text only).
 * Size "navbar" is the compact variant used in the site header.
 */
interface Props extends HTMLAttributes<"button">, Omit<HTMLAttributes<"a">, "type"> {
  variant?: "primary" | "secondary" | "secondary-trailing" | "ghost";
  size?: "default" | "navbar";
  /** square marker before or after the label; defaults to after for primary, before for secondary */
  marker?: "leading" | "trailing" | "none";
}

const {
  variant = "primary",
  size = "default",
  marker,
  class: className,
  href,
  ...rest
} = Astro.props;

// Normalize internal links to remove trailing slash (except root)
let normalizedHref = href;
if (href && typeof href === "string") {
  const domain = import.meta.env.SITE;
  const isExternal = !href.includes(domain) && !href.startsWith("/") && !href.startsWith("#");
  if (!isExternal && href.startsWith("/") && href !== "/" && href.endsWith("/")) {
    normalizedHref = href.slice(0, -1);
  }
}

const defaultMarker: Record<string, "leading" | "trailing" | "none"> = {
  primary: "trailing",
  secondary: "leading",
  "secondary-trailing": "trailing",
  ghost: "none",
};
const markerPosition = marker ?? defaultMarker[variant];

const Component = href ? "a" : "button";
---

<Component
  class:list={[
    className,
    "button group",
    "button--" + variant,
    { "button--navbar": size === "navbar" },
    markerPosition !== "none" && "button--marker-" + markerPosition,
  ]}
  {...(href ? { href: normalizedHref } : {})}
  {...rest}
>
  <slot />
</Component>
