---
/**
 * * "CLI first, platform when you scale" section.
 * Two selectable cards (CLI / Platform) that swap the media panel below.
 * CLI shows the live scan animation; Platform shows a "coming soon" placeholder.
 */
import PipelineAnimation from "@components/Animation/PipelineAnimation.astro";
import BeforeAfterPipeline from "@components/BeforeAfter/BeforeAfterPipeline.astro";
import githubBlackLogo from "@images/github-black.svg";
import githubWhiteLogo from "@images/github-white.svg";
import gitlabDarkLogo from "@images/gitlab-dark.svg";
import gitlabWhiteLogo from "@images/gilab-white.svg";
import { Image } from "astro:assets";
---

<section
  id="platform"
  class="border-base-300 dark:border-base-600/60 scroll-mt-20 border-t bg-black/[0.02] py-20 md:py-28 dark:bg-white/[0.015]"
  data-clivp
>
  <div class="site-container text-center">
    <p
      class="section-eyebrow"
      data-mos="fade-up"
      data-mos-anchor="#platform"
    >
      CLI first, platform when you scale
    </p>
    <h2
      class="h2 mt-4"
      data-mos="fade-up"
      data-mos-delay="0.1"
      data-mos-anchor="#platform"
    >
      Start in the terminal. Grow into the dashboard.
    </h2>

    <!-- selectable cards -->
    <div class="mt-10 grid gap-4 text-left md:grid-cols-2">
      <button
        type="button"
        data-clivp-tab="cli"
        aria-pressed="true"
        class="clivp-card group rounded-2xl border p-6 text-left transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 dark:focus-visible:ring-primary-400"
        data-mos="fade-up"
        data-mos-delay="0.2"
        data-mos-anchor="#platform"
      >
        <span class="clivp-eyebrow font-mono text-xs font-medium tracking-[0.1em] uppercase">
          The CLI
        </span>
        <span class="text-base-900 dark:text-base-100 mt-2 block text-xl font-semibold tracking-tight">
          Scan from your CI
        </span>
        <span class="text-base-700 dark:text-base-300 mt-2 block text-sm leading-relaxed opacity-90 dark:opacity-80">
          One pipeline at a time · open source · advisory fixes · zero setup.
        </span>
        <span class="text-base-600 dark:text-base-400 mt-2.5 block text-sm leading-relaxed">
          Run it locally or in CI, as a GitHub Action or a GitLab CI component.
        </span>
        <span class="mt-4 flex items-center gap-3">
          <Image src={gitlabDarkLogo} alt="GitLab" class="block h-4 w-auto opacity-80 dark:hidden" />
          <Image src={gitlabWhiteLogo} alt="GitLab" class="hidden h-4 w-auto opacity-80 dark:block" />
          <Image src={githubBlackLogo} alt="GitHub" class="block h-4 w-auto opacity-90 dark:hidden" />
          <Image src={githubWhiteLogo} alt="GitHub" class="hidden h-4 w-auto opacity-90 dark:block" />
        </span>
      </button>

      <button
        type="button"
        data-clivp-tab="platform"
        aria-pressed="false"
        class="clivp-card group rounded-2xl border p-6 text-left transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 dark:focus-visible:ring-primary-400"
        data-mos="fade-up"
        data-mos-delay="0.3"
        data-mos-anchor="#platform"
      >
        <span class="clivp-eyebrow font-mono text-xs font-medium tracking-[0.1em] uppercase">
          The Platform
        </span>
        <span class="text-base-900 dark:text-base-100 mt-2 block text-xl font-semibold tracking-tight">
          Monitor the whole org
        </span>
        <span class="text-base-700 dark:text-base-300 mt-2 block text-sm leading-relaxed opacity-90 dark:opacity-80">
          Org-wide dashboards · drift alerts · AI fixes · audit-ready reports. Free up to 10
          projects.
        </span>
        <span class="mt-4 flex items-center gap-3">
          <Image src={gitlabDarkLogo} alt="GitLab" class="block h-4 w-auto opacity-80 dark:hidden" />
          <Image src={gitlabWhiteLogo} alt="GitLab" class="hidden h-4 w-auto opacity-80 dark:block" />
          <Image src={githubBlackLogo} alt="GitHub" class="block h-4 w-auto opacity-90 dark:hidden" />
          <Image src={githubWhiteLogo} alt="GitHub" class="hidden h-4 w-auto opacity-90 dark:block" />
        </span>
      </button>
    </div>

    <!-- Media panel: each animation already carries its own framing, so there's
         no extra card wrapper. text-left resets the section's centered text so the
         CLI terminal output reads left-to-right like a real terminal (the heading
         above stays centered); the platform animation centers its own captions. -->
    <div
      class="mt-8 text-left"
      data-mos="fade-up"
      data-mos-delay="0.35"
      data-mos-anchor="#platform"
    >
      <div data-clivp-media="cli">
        <PipelineAnimation />
      </div>
      <div data-clivp-media="platform" hidden>
        <BeforeAfterPipeline variant="platform" />
      </div>
    </div>
  </div>
</section>

<style>
  .clivp-card {
    border-color: var(--border);
    background: transparent;
  }

  /* Eyebrow ("THE CLI" / "THE PLATFORM"): muted by default, green only when its
     card is the active one — matching the wireframe's selected-card accent. */
  .clivp-eyebrow {
    color: color-mix(in srgb, var(--foreground) 55%, transparent);
  }

  /* Active card: wireframe green accent + faint green fill. Light mode uses a
     deeper green so the border/label stay readable on a light surface. */
  .clivp-card[aria-pressed="true"] {
    border-color: #008700;
    background: rgba(0, 212, 0, 0.07);
  }
  .clivp-card[aria-pressed="true"] .clivp-eyebrow {
    color: #008700;
  }

  :global(.dark) .clivp-card[aria-pressed="true"] {
    border-color: #00d400;
  }
  :global(.dark) .clivp-card[aria-pressed="true"] .clivp-eyebrow {
    color: #00d400;
  }

  /* The CLI terminal defaults to an 800px cap; let it grow to the full media
     width (matching the two cards above). The animation is responsive, so it
     reflows safely on narrower screens. */
  [data-clivp-media="cli"] :global(.pipeline-animation-container) {
    width: 100%;
    max-width: 100%;
  }
</style>

<script>
  function initCliVsPlatform() {
    document.querySelectorAll<HTMLElement>("[data-clivp]").forEach((section) => {
      if (section.dataset.clivpInit === "true") return;
      section.dataset.clivpInit = "true";

      const tabs = section.querySelectorAll<HTMLButtonElement>("[data-clivp-tab]");
      const medias = section.querySelectorAll<HTMLElement>("[data-clivp-media]");

      const select = (target: string) => {
        tabs.forEach((t) =>
          t.setAttribute("aria-pressed", t.dataset.clivpTab === target ? "true" : "false"),
        );
        medias.forEach((m) => {
          m.hidden = m.dataset.clivpMedia !== target;
        });
      };

      tabs.forEach((t) =>
        t.addEventListener("click", () => select(t.dataset.clivpTab || "cli")),
      );
    });
  }

  initCliVsPlatform();
  document.addEventListener("astro:after-swap", initCliVsPlatform);
</script>
