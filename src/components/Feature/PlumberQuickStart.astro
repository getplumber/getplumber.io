---
/**
 * * Quick Start CTA section with 3 steps
 * Centered like the other landing sections; numbered step cards match the
 * "How it works" (TheLoop) card style so the page reads as one system.
 */
import githubIconBlack from "@images/github-icon-black.svg";
import githubIconWhite from "@images/github-icon-white.svg";
import gitlabIcon from "@images/gitlab-icon.svg";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

interface ProviderCta {
  href: string;
  title: string;
}

const providerCtas: ProviderCta[] = [
  { href: "/docs/cli/gitlab", title: "Get started with GitLab" },
  { href: "/docs/cli/github", title: "Get started with GitHub" },
];

interface StepData {
  title: string;
  text: string;
}

const steps: StepData[] = [
  {
    title: "Set up Plumber in your repository",
    text: "Add the Plumber CI component to your GitLab pipeline or the Plumber Action to your GitHub workflow, then configure controls: registries, action pinning, branch protection.",
  },
  {
    title: "Run your CI/CD pipeline",
    text: "Plumber runs as part of your pipeline and scans your CI configuration and job or workflow definitions.",
  },
  {
    title: "Get your compliance report",
    text: "View results in the job output or download the report artifact for audit and remediation.",
  },
];
---

<section
  id="plumber-cta"
  class="section-alt border-base-300 dark:border-base-600/60 scroll-mt-20 border-t py-20 md:py-28"
>
  <div class="site-container text-center">
    <p class="section-eyebrow" data-mos="fade-up" data-mos-anchor="#plumber-cta">Quick Start</p>
    <h2 class="h2 mt-4" data-mos="fade-up" data-mos-delay="0.1" data-mos-anchor="#plumber-cta">
      Get started in minutes
    </h2>
    <p
      class="description mx-auto mt-4 max-w-xl"
      data-mos="fade-up"
      data-mos-delay="0.2"
      data-mos-anchor="#plumber-cta"
    >
      Set up Plumber in your GitLab CI/CD pipeline or GitHub Actions workflow with just a few
      simple steps.
    </p>

    <!-- 2 columns from sm (third card spans full width), 3-up only on lg+
         so the cards never get cramped at tablet widths -->
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        steps.map((step, idx) => (
          <div
            class:list={[
              "border-base-300 dark:border-base-600/60 dark:bg-base-900 hover:border-primary-300 dark:hover:border-base-500 rounded-2xl border bg-transparent p-6 text-left transition duration-300",
              idx === 2 && "sm:col-span-2 lg:col-span-1",
            ]}
            data-mos="fade-up"
            data-mos-delay={`${idx * 0.15 + 0.25}`}
            data-mos-anchor="#plumber-cta"
          >
            <div class="text-primary-600 dark:text-primary-400 font-mono text-sm font-bold tracking-wide">
              0{idx + 1}
            </div>
            <h3 class="text-base-900 dark:text-base-100 mt-3 text-lg font-semibold tracking-tight">
              {step.title}
            </h3>
            <p class="text-base-700 dark:text-base-300 mt-1.5 text-sm leading-relaxed opacity-90 dark:opacity-80">
              {step.text}
            </p>
          </div>
        ))
      }
    </div>

    <!-- Platform docs: horizontal action bar (not step cards) -->
    <div
      class="mx-auto mt-10 max-w-3xl md:mt-12"
      data-mos="fade-up"
      data-mos-delay="0.7"
      data-mos-anchor="#plumber-cta"
    >
      <p
        class="text-base-500 dark:text-base-400 mb-3 text-center text-xs font-medium tracking-wider uppercase"
      >
        Platform guides
      </p>
      <div
        class="border-base-300 dark:border-base-600/50 dark:bg-base-900/30 divide-base-300 dark:divide-base-600/50 bg-base-100/40 flex flex-col divide-y overflow-hidden rounded-xl border sm:flex-row sm:divide-x sm:divide-y-0"
      >
          {
            providerCtas.map((cta) => {
              const isGitlab = cta.href.includes("gitlab");
              return (
                <a
                  href={cta.href}
                  class="group hover:bg-primary-500/[0.06] dark:hover:bg-primary-500/[0.08] focus-visible:ring-primary-500 dark:focus-visible:ring-primary-400 flex min-h-0 flex-1 items-center justify-between gap-4 px-5 py-4 no-underline transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset sm:px-6 sm:py-5"
                >
                  <span class="flex min-w-0 items-center gap-3.5">
                    <span class="bg-base-200/80 dark:bg-base-800/80 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-base-300/60 dark:border-base-600/50">
                      {isGitlab ? (
                        <Image
                          src={gitlabIcon}
                          alt=""
                          class="h-6 w-6"
                          aria-hidden="true"
                          loading="lazy"
                        />
                      ) : (
                        <>
                          <Image
                            src={githubIconBlack}
                            alt=""
                            class="block h-6 w-6 dark:hidden"
                            aria-hidden="true"
                            loading="lazy"
                          />
                          <Image
                            src={githubIconWhite}
                            alt=""
                            class="hidden h-6 w-6 dark:block"
                            aria-hidden="true"
                            loading="lazy"
                          />
                        </>
                      )}
                    </span>
                    <span class="min-w-0 text-left">
                      <span class="text-base-900 dark:text-base-100 block text-sm font-semibold leading-snug sm:text-base">
                        {cta.title}
                      </span>
                      <span class="text-base-500 dark:text-base-400 mt-0.5 block text-xs leading-snug">
                        {isGitlab
                          ? "CI component, controls, and GitLab-specific setup"
                          : "GitHub Action, workflow scanning, and controls"}
                      </span>
                    </span>
                  </span>
                  <Icon
                    name="tabler/arrow-narrow-right"
                    class="text-base-400 group-hover:text-primary-600 dark:group-hover:text-primary-400 h-5 w-5 shrink-0 transition-transform duration-300 group-hover:translate-x-0.5"
                    aria-hidden="true"
                  />
                </a>
              );
            })
          }
      </div>
    </div>
  </div>
</section>
