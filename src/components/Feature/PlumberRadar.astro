---
/**
 * * Plumber Radar showcase section.
 * Centered heading + a dark "getplumber.io/radar" dashboard window illustration.
 *
 * The window mirrors the real radar app (plumber-gitlab-ecosystem-scan):
 *   - KPI strip: Projects scanned · Avg score (A–E grade boxes, like the Plumber
 *     Score section) · Total issues split by severity (full-width so it never wraps).
 *   - Projects table: Nutri-style A–E score, provider, path, issues by severity,
 *     and the per-row "Improve" CTA (with a cursor on the worst project).
 * It is a self-contained dark mock, so colors are intentionally hard-coded (not
 * theme tokens) and stay dark in both light and dark mode. Figures are a snapshot
 * of the live radar (getplumber.io/radar — /api/stats); refresh them periodically.
 */
import Button from "@components/Button/Button.astro";
import githubIconWhite from "@images/github-icon-white.svg";
import gitlabIcon from "@images/gitlab-icon.svg";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

// Nutri-style grade palette (matches the radar app's score badges)
const GRADE: Record<string, { bg: string; fg: string }> = {
  A: { bg: "#1faa4e", fg: "#fff" },
  B: { bg: "#7bc62d", fg: "#0c0e0c" },
  C: { bg: "#e8c21d", fg: "#0c0e0c" },
  D: { bg: "#ef8a1a", fg: "#0c0e0c" },
  E: { bg: "#df4b2c", fg: "#fff" },
};
const LETTERS = ["A", "B", "C", "D", "E"] as const;

// Aggregate KPIs — snapshot from getplumber.io/radar (/api/stats, all providers)
const projectsScanned = 8247;
const avgScore = "D";
const issueSeverity = [
  { label: "Critical", count: 10096, color: "#df4b2c" },
  { label: "High", count: 79867, color: "#ef8a1a" },
  { label: "Medium", count: 44102, color: "#e8c21d" },
  { label: "Low", count: 5, color: "#a1a1aa" },
];

// Per-row severity badge order + colors (match the KPI strip)
const SEVERITIES = [
  { key: "critical", label: "Critical", color: "#df4b2c" },
  { key: "high", label: "High", color: "#ef8a1a" },
  { key: "medium", label: "Medium", color: "#e8c21d" },
  { key: "low", label: "Low", color: "#a1a1aa" },
] as const;

interface ProjectRow {
  letter: keyof typeof GRADE;
  provider: "gitlab" | "github";
  segments: [number, number]; // anonymized path segment widths (px)
  issues: { critical: number; high: number; medium: number; low: number };
  /** Weekly score trend vs the ~7-day-ago baseline scan (like the live radar). */
  trend?: "up" | "down";
  /** Worst project: show a cursor focusing its "Improve" button. */
  cursor?: boolean;
}

// Sorted worst → best (E → A): the riskiest projects surface first, mirroring
// the radar's "sorted by score". Issue counts track the grade; each project
// carries some low findings, like the live radar's per-project severity split.
const projectRows: ProjectRow[] = [
  { letter: "E", provider: "gitlab", segments: [62, 78], issues: { critical: 4, high: 9, medium: 7, low: 2 }, trend: "down", cursor: true },
  { letter: "D", provider: "github", segments: [68, 72], issues: { critical: 1, high: 5, medium: 6, low: 3 } },
  { letter: "C", provider: "gitlab", segments: [56, 86], issues: { critical: 0, high: 3, medium: 4, low: 5 } },
  { letter: "B", provider: "github", segments: [70, 64], issues: { critical: 0, high: 1, medium: 2, low: 4 }, trend: "up" },
  { letter: "A", provider: "gitlab", segments: [58, 80], issues: { critical: 0, high: 0, medium: 0, low: 3 } },
];
---

<section
  id="plumber-radar"
  class="section-alt border-base-300 dark:border-base-600/60 relative scroll-mt-20 overflow-hidden border-t"
>
  <div class="site-container py-20 text-center md:py-28">
    <p class="section-eyebrow" data-mos="fade-up" data-mos-anchor="#plumber-radar">Plumber Radar</p>
    <h2 class="h2 mt-4" data-mos="fade-up" data-mos-delay="0.1" data-mos-anchor="#plumber-radar">
      The state of CI/CD security across <span class="text-primary-500">open source</span>
    </h2>
    <p
      class="description mx-auto mt-4 max-w-xl"
      data-mos="fade-up"
      data-mos-delay="0.2"
      data-mos-anchor="#plumber-radar"
    >
      A free initiative that continuously scans public GitLab and GitHub projects and scores their
      CI/CD security, so the whole ecosystem can see where it stands.
    </p>

    <div
      class="mt-8 flex flex-wrap items-center justify-center gap-4"
      data-mos="fade-up"
      data-mos-delay="0.3"
      data-mos-anchor="#plumber-radar"
    >
      <Button variant="primary" href="/radar" arrow="right">Explore the Radar</Button>
      <a
        href="/radar"
        class="text-base-600 dark:text-base-300 hover:text-primary-600 dark:hover:text-primary-400 inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
      >
        <Icon name="tabler/search" class="h-4 w-4" aria-hidden="true" />
        Scan a public project
      </a>
    </div>

    <!-- dashboard window illustration -->
    <div
      class="radar-window mx-auto mt-12 max-w-[940px] text-left"
      data-mos="fade-up"
      data-mos-delay="0.3"
      data-mos-anchor="#plumber-radar"
    >
      <!-- window header -->
      <div class="radar-bar">
        <span class="radar-tl-dot" style="background:#e0573a"></span>
        <span class="radar-tl-dot" style="background:#e8c21d"></span>
        <span class="radar-tl-dot" style="background:#1faa4e"></span>
        <span class="radar-url">getplumber.io/radar</span>
        <span class="radar-live"><span class="live-dot"></span>LIVE</span>
      </div>

      <!-- KPI strip: Projects + Avg score on row 1, Total issues full-width row 2 -->
      <div class="radar-kpis">
        <div class="radar-panel radar-kpi">
          <span class="radar-kpi-label">Projects scanned</span>
          <span class="radar-kpi-value">{projectsScanned.toLocaleString("en-US")}</span>
        </div>

        <div class="radar-panel radar-kpi">
          <span class="radar-kpi-label">Avg score</span>
          <span class="radar-score-bar" role="img" aria-label={`Average Plumber score ${avgScore}`}>
            {
              LETTERS.map((l) => {
                const c = GRADE[l].bg;
                const active = l === avgScore;
                return (
                  <span
                    class:list={["rs-seg", active && "rs-seg--active"]}
                    style={
                      active
                        ? /* solid fill + glow so the current grade is unmissable */
                          `color:${GRADE[l].fg};background:${c};border:2px solid ${c};box-shadow:0 0 0 4px ${c}33, 0 8px 24px -6px ${c}66;`
                        : `color:${c};border:1px solid ${c}80;background:${c}1f;`
                    }
                  >
                    {l}
                  </span>
                );
              })
            }
          </span>
        </div>

        <div class="radar-panel radar-kpi radar-kpi--issues">
          <span class="radar-kpi-label">Total issues</span>
          <span class="radar-sev">
            {
              issueSeverity.map((s) => (
                <span
                  class="radar-sev-badge"
                  style={`color:${s.color};border-color:${s.color}55;background:${s.color}1f`}
                >
                  {s.label} {s.count.toLocaleString("en-US")}
                </span>
              ))
            }
          </span>
        </div>
      </div>

      <!-- projects table -->
      <div class="radar-scans-wrap">
        <div class="radar-panel">
          <div class="radar-panel-head radar-scans-head">
            <span class="radar-panel-title">Projects</span>
            <span class="radar-meta">sorted by score</span>
          </div>
          <ul class="radar-rows">
            {
              projectRows.map((row) => (
                <li class="radar-row">
                  <span class="radar-row-head">
                    <span
                      class="radar-grade"
                      style={`background:${GRADE[row.letter].bg};color:${GRADE[row.letter].fg}`}
                    >
                      {row.letter}
                    </span>
                    {row.trend && (
                      <span
                        class:list={["radar-trend", `radar-trend--${row.trend}`]}
                        aria-label={`score trending ${row.trend} this week`}
                      >
                        {row.trend === "up" ? "▲" : "▼"}
                      </span>
                    )}
                    <Image
                      src={row.provider === "gitlab" ? gitlabIcon : githubIconWhite}
                      alt={row.provider === "gitlab" ? "GitLab" : "GitHub"}
                      class="radar-row-provider"
                    />
                    <span class="radar-path" aria-hidden="true">
                      <span class="radar-path-seg" style={`width:${row.segments[0]}px`} />
                      <span class="radar-path-slash">/</span>
                      <span class="radar-path-seg" style={`width:${row.segments[1]}px`} />
                    </span>
                  </span>
                  <span class="radar-row-issues">
                    {
                      SEVERITIES.filter((s) => row.issues[s.key] > 0).map((s) => (
                        <span
                          class="radar-issue"
                          style={`color:${s.color};border-color:${s.color}55;background:${s.color}1f`}
                        >
                          {s.label} {row.issues[s.key]}
                        </span>
                      ))
                    }
                  </span>
                  <span class="radar-improve-wrap">
                    <span class:list={["radar-improve", row.cursor && "radar-improve--focus"]}>
                      Improve
                    </span>
                    {row.cursor && (
                      <svg class="radar-cursor" viewBox="0 0 24 24" aria-hidden="true">
                        <path
                          d="M5 2.5l14.5 8.7-6.6 1.1-3.4 6.6L5 2.5z"
                          fill="#ffffff"
                          stroke="#0c0e0c"
                          stroke-width="1.4"
                          stroke-linejoin="round"
                        />
                      </svg>
                    )}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── window shell ─────────────────────────────────────────── */
  .radar-window {
    border: 1px solid rgba(245, 245, 245, 0.12);
    border-radius: 16px;
    background: #080a08;
    overflow: hidden;
    color: rgba(245, 245, 245, 0.9);
    /* Light mode: soft neutral depth + a hint of green. */
    box-shadow:
      0 30px 70px -45px rgba(2, 6, 23, 0.4),
      0 24px 80px -45px rgba(0, 212, 0, 0.18);
  }

  /* Dark mode: prominent directional green glow. */
  :global(.dark) .radar-window {
    box-shadow:
      0 40px 90px -50px rgba(0, 212, 0, 0.3),
      0 20px 60px -35px rgba(0, 0, 0, 0.55);
  }

  /* ── header ───────────────────────────────────────────────── */
  .radar-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid rgba(245, 245, 245, 0.08);
  }

  .radar-tl-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .radar-url {
    font-family: var(--font-mono);
    font-size: 12px;
    color: rgba(245, 245, 245, 0.5);
    margin-left: 6px;
  }

  .radar-live {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid rgba(0, 212, 0, 0.4);
    border-radius: 999px;
    padding: 4px 11px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #00d400;
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00d400;
    box-shadow: 0 0 8px #00d400;
    animation: radar-pulse 1.6s ease-in-out infinite;
  }

  /* ── shared panel ─────────────────────────────────────────── */
  .radar-panel {
    border: 1px solid rgba(245, 245, 245, 0.1);
    border-radius: 12px;
    background: rgba(245, 245, 245, 0.02);
    padding: 16px;
  }

  .radar-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .radar-panel-title {
    font-weight: 700;
    font-size: 15px;
    color: #f5f5f5;
  }

  .radar-meta {
    border: 1px solid rgba(245, 245, 245, 0.12);
    border-radius: 7px;
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgba(245, 245, 245, 0.5);
  }

  /* ── KPI strip ────────────────────────────────────────────── */
  .radar-kpis {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 14px;
    padding: 16px;
  }

  /* Total issues spans the full width on its own row so the severity badges
     never wrap on desktop. */
  .radar-kpi--issues {
    grid-column: 1 / -1;
  }

  .radar-kpi {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .radar-kpi-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.45);
  }

  .radar-kpi-value {
    font-weight: 700;
    font-size: 26px;
    line-height: 1;
    color: #f5f5f5;
    margin-top: auto;
  }

  /* avg-score A–E boxes (same visual language as "The Plumber Score" section) */
  .radar-score-bar {
    display: flex;
    gap: 6px;
    margin-top: auto;
  }

  .rs-seg {
    flex: 1;
    height: 46px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 17px;
  }

  .rs-seg--active {
    font-size: 20px;
  }

  /* total-issues severity badges */
  .radar-sev {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
  }

  .radar-sev-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    border: 1px solid;
    border-radius: 7px;
    padding: 4px 8px;
    white-space: nowrap;
  }

  /* ── projects table ───────────────────────────────────────── */
  .radar-scans-wrap {
    padding: 0 16px 16px;
  }

  .radar-scans-head {
    margin-bottom: 6px;
  }

  .radar-rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .radar-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 0;
    border-top: 1px solid rgba(245, 245, 245, 0.07);
  }

  .radar-row-head {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .radar-grade {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border-radius: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
  }

  /* weekly score trend vs the ~7-day baseline (like PlumberScoreTrend) */
  .radar-trend {
    flex-shrink: 0;
    font-size: 10px;
    line-height: 1;
  }

  .radar-trend--up {
    color: #4fe24f;
  }

  .radar-trend--down {
    color: #df4b2c;
  }

  .radar-row-provider {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    opacity: 0.85;
  }

  /* "group / project" — larger, more legible */
  .radar-path {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 180px;
    flex-shrink: 0;
  }

  .radar-path-seg {
    height: 9px;
    background: rgba(245, 245, 245, 0.16);
    border-radius: 4px;
  }

  .radar-path-slash {
    color: rgba(245, 245, 245, 0.3);
    font-size: 13px;
  }

  .radar-row-issues {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    min-width: 0;
  }

  .radar-issue {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    border: 1px solid;
    border-radius: 6px;
    padding: 2px 6px;
    white-space: nowrap;
  }

  /* per-row "Improve" CTA (matches the radar app's row-improve-btn) */
  .radar-improve-wrap {
    position: relative;
    flex-shrink: 0;
    display: inline-flex;
  }

  .radar-improve {
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 10px;
    border-radius: 6px;
    border: 1px solid rgba(0, 212, 0, 0.4);
    background: rgba(0, 135, 0, 0.12);
    color: #4fe24f;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
  }

  .radar-improve--focus {
    border-color: #00d400;
    background: rgba(0, 212, 0, 0.22);
    color: #7bf07b;
    box-shadow: 0 0 0 3px rgba(0, 212, 0, 0.25);
  }

  .radar-cursor {
    position: absolute;
    right: 8px;
    bottom: -4px;
    width: 20px;
    height: 20px;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.7));
    pointer-events: none;
  }

  /* ── responsive ───────────────────────────────────────────── */
  @media (max-width: 760px) {
    .radar-kpis {
      grid-template-columns: 1fr;
    }
  }

  /* Project rows become cards on mobile (like the radar app): the group/project
     skeletons stay visible and the severity badges get their own row instead of
     cramming onto a single line. */
  @media (max-width: 680px) {
    .radar-rows {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .radar-row {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 14px;
      border: 1px solid rgba(245, 245, 245, 0.1);
      border-radius: 12px;
      background: rgba(245, 245, 245, 0.02);
    }

    .radar-row-issues {
      justify-content: flex-start;
    }

    /* let the path skeleton compress so grade + trend + provider + path
       always fit inside the card */
    .radar-path {
      flex-shrink: 1;
      min-width: 0;
      overflow: hidden;
    }

    .radar-improve-wrap {
      align-self: flex-end;
    }
  }

  /* ── animations ───────────────────────────────────────────── */
  @keyframes radar-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-dot {
      animation: none;
    }
  }
</style>
