---
/**
 * * Plumber Radar showcase section.
 * Centered heading + a dark "getplumber.io/radar" dashboard window illustration
 * (radar scope + KPIs + recent scans), matching the landing wireframe.
 *
 * The window is a self-contained dark mock, so its colors are intentionally
 * hard-coded (not theme tokens) and stay dark in both light and dark mode.
 */
import Button from "@components/Button/Button.astro";
import { Icon } from "astro-icon/components";

interface RadarRow {
  letter: "A" | "B" | "C" | "D" | "E";
  bg: string; // grade badge + bar color
  fg: string; // grade badge text color
  compliance: number; // 0-100
  segments: [number, number]; // anonymized path segment widths (px)
}

const radarRows: RadarRow[] = [
  { letter: "A", bg: "#1faa4e", fg: "#fff", compliance: 96, segments: [42, 54] },
  { letter: "B", bg: "#7bc62d", fg: "#0c0e0c", compliance: 84, segments: [50, 46] },
  { letter: "C", bg: "#e8c21d", fg: "#0c0e0c", compliance: 71, segments: [40, 58] },
  { letter: "D", bg: "#ef8a1a", fg: "#0c0e0c", compliance: 53, segments: [48, 50] },
  { letter: "E", bg: "#df4b2c", fg: "#fff", compliance: 32, segments: [44, 52] },
];

// Blips scattered across the scope (position %, size px, animation delay s)
const blips = [
  { left: 60, top: 31, size: 7, delay: 0 },
  { left: 70, top: 52, size: 6, delay: 0.6 },
  { left: 38, top: 42, size: 7, delay: 1 },
  { left: 30, top: 64, size: 6, delay: 1.4 },
  { left: 55, top: 72, size: 6, delay: 1.8 },
];
---

<section
  id="plumber-radar"
  class="border-base-300 dark:border-base-600/60 relative scroll-mt-20 overflow-hidden border-t bg-black/[0.02] dark:bg-white/[0.015]"
>
  <div class="site-container py-24 text-center md:py-32">
    <p class="section-eyebrow" data-mos="fade-up" data-mos-anchor="#plumber-radar">Plumber Radar</p>
    <h2 class="h2 mt-4" data-mos="fade-up" data-mos-delay="0.1" data-mos-anchor="#plumber-radar">
      The state of CI/CD security across <span class="text-primary-500">open source</span>
    </h2>
    <p
      class="description mx-auto mt-4 max-w-xl"
      data-mos="fade-up"
      data-mos-delay="0.2"
      data-mos-anchor="#plumber-radar"
    >
      A free initiative that continuously scans public open-source projects and scores their CI/CD
      security, so the whole ecosystem can see where it stands.
    </p>

    <div
      class="mt-8 flex flex-wrap items-center justify-center gap-4"
      data-mos="fade-up"
      data-mos-delay="0.3"
      data-mos-anchor="#plumber-radar"
    >
      <Button variant="primary" href="/radar" arrow="right">Explore the Radar</Button>
      <a
        href="/radar"
        class="text-base-600 dark:text-base-300 hover:text-primary-600 dark:hover:text-primary-400 inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
      >
        <Icon name="tabler/search" class="h-4 w-4" aria-hidden="true" />
        Scan a public project
      </a>
    </div>

    <!-- dashboard window illustration -->
    <div
      class="radar-window mx-auto mt-12 max-w-[940px] text-left"
      data-mos="fade-up"
      data-mos-delay="0.3"
      data-mos-anchor="#plumber-radar"
    >
      <!-- window header -->
      <div class="radar-bar">
        <span class="radar-tl-dot" style="background:#e0573a"></span>
        <span class="radar-tl-dot" style="background:#e8c21d"></span>
        <span class="radar-tl-dot" style="background:#1faa4e"></span>
        <span class="radar-url">getplumber.io/radar</span>
        <span class="radar-live"><span class="live-dot"></span>LIVE</span>
      </div>

      <!-- body: radar scope + KPI stack -->
      <div class="radar-body">
        <div class="radar-panel radar-scope">
          <div class="radar-panel-head">
            <span class="radar-panel-title">Live Plumber Radar</span>
          </div>
          <div class="radar-scope-circle" aria-hidden="true">
            <div class="radar-ring" style="inset:17%"></div>
            <div class="radar-ring" style="inset:34%"></div>
            <div class="radar-ring" style="inset:51%"></div>
            <div class="radar-cross-h"></div>
            <div class="radar-cross-v"></div>
            <div class="radar-sweep"></div>
            {
              blips.map((b) => (
                <div
                  class="radar-blip"
                  style={`left:${b.left}%;top:${b.top}%;width:${b.size}px;height:${b.size}px;animation-delay:${b.delay}s`}
                />
              ))
            }
            <div class="radar-center"></div>
          </div>
        </div>

        <div class="radar-stats">
          <div class="radar-panel radar-stat">
            <div class="radar-stat-label">AVG SCORE</div>
            <div class="radar-stat-value" style="color:#7bd44a">B</div>
            <div class="radar-stat-sub">79.1 / 100</div>
          </div>
          <div class="radar-panel radar-stat">
            <div class="radar-stat-label">FINDINGS</div>
            <div class="radar-stat-value radar-stat-value-sm" style="color:#e8c21d">4,356</div>
            <span class="radar-badge">715 high+</span>
          </div>
        </div>
      </div>

      <!-- recent scans -->
      <div class="radar-scans-wrap">
        <div class="radar-panel">
          <div class="radar-panel-head radar-scans-head">
            <span class="radar-panel-title">Recent scans</span>
            <span class="radar-meta">sorted by score</span>
          </div>
          <ul class="radar-rows">
            {
              radarRows.map((row) => (
                <li class="radar-row">
                  <span class="radar-grade" style={`background:${row.bg};color:${row.fg}`}>
                    {row.letter}
                  </span>
                  <span class="radar-path" aria-hidden="true">
                    <span class="radar-path-seg" style={`width:${row.segments[0]}px`} />
                    <span class="radar-path-slash">/</span>
                    <span class="radar-path-seg" style={`width:${row.segments[1]}px`} />
                  </span>
                  <span class="radar-track">
                    <span
                      class="radar-fill"
                      style={`width:${row.compliance}%;background:${row.bg}`}
                    />
                  </span>
                  <span class="radar-pct">{row.compliance}%</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── window shell ─────────────────────────────────────────── */
  .radar-window {
    border: 1px solid rgba(245, 245, 245, 0.12);
    border-radius: 16px;
    background: #080a08;
    overflow: hidden;
    color: rgba(245, 245, 245, 0.9);
    /* Light mode: soft neutral depth + a hint of green. */
    box-shadow:
      0 30px 70px -45px rgba(2, 6, 23, 0.4),
      0 24px 80px -45px rgba(0, 212, 0, 0.18);
  }

  /* Dark mode: the wireframe's prominent directional green glow. */
  :global(.dark) .radar-window {
    box-shadow:
      0 40px 90px -50px rgba(0, 212, 0, 0.3),
      0 20px 60px -35px rgba(0, 0, 0, 0.55);
  }

  /* ── header ───────────────────────────────────────────────── */
  .radar-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid rgba(245, 245, 245, 0.08);
  }

  .radar-tl-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .radar-url {
    font-family: var(--font-mono);
    font-size: 12px;
    color: rgba(245, 245, 245, 0.5);
    margin-left: 6px;
  }

  .radar-live {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid rgba(0, 212, 0, 0.4);
    border-radius: 999px;
    padding: 4px 11px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #00d400;
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00d400;
    box-shadow: 0 0 8px #00d400;
    animation: radar-pulse 1.6s ease-in-out infinite;
  }

  /* ── body grid ────────────────────────────────────────────── */
  .radar-body {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 14px;
    padding: 16px;
  }

  .radar-panel {
    border: 1px solid rgba(245, 245, 245, 0.1);
    border-radius: 12px;
    background: rgba(245, 245, 245, 0.02);
    padding: 18px;
  }

  .radar-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .radar-panel-title {
    font-weight: 700;
    font-size: 15px;
    color: #f5f5f5;
  }

  .radar-meta {
    border: 1px solid rgba(245, 245, 245, 0.12);
    border-radius: 7px;
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgba(245, 245, 245, 0.5);
  }

  /* ── radar scope ──────────────────────────────────────────── */
  .radar-scope-circle {
    position: relative;
    width: 100%;
    max-width: 280px;
    aspect-ratio: 1 / 1;
    margin: 0 auto;
    border-radius: 50%;
    border: 1px solid rgba(0, 212, 0, 0.25);
    overflow: hidden;
    background: radial-gradient(circle, rgba(0, 212, 0, 0.07), transparent 72%);
  }

  .radar-ring {
    position: absolute;
    border: 1px solid rgba(0, 212, 0, 0.16);
    border-radius: 50%;
  }

  .radar-cross-h {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: rgba(0, 212, 0, 0.14);
  }

  .radar-cross-v {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: rgba(0, 212, 0, 0.14);
  }

  .radar-sweep {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 180deg,
      rgba(0, 212, 0, 0.4),
      rgba(0, 212, 0, 0.05) 55deg,
      transparent 60deg
    );
    transform-origin: 50% 50%;
    animation: radar-spin 4s linear infinite;
  }

  .radar-blip {
    position: absolute;
    border-radius: 50%;
    background: #4fe24f;
    box-shadow: 0 0 8px #4fe24f;
    animation: radar-blip-glow 2.4s ease-in-out infinite;
  }

  .radar-center {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 12px;
    margin: -6px;
    border-radius: 50%;
    background: #00d400;
    box-shadow: 0 0 14px #00d400;
  }

  /* ── KPI stack ────────────────────────────────────────────── */
  .radar-stats {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .radar-stat {
    flex: 1;
  }

  .radar-stat-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.5px;
    color: rgba(245, 245, 245, 0.45);
  }

  .radar-stat-value {
    font-weight: 700;
    font-size: 46px;
    line-height: 1.05;
    margin-top: 8px;
  }

  .radar-stat-value-sm {
    font-size: 36px;
  }

  .radar-stat-sub {
    font-size: 13px;
    color: rgba(245, 245, 245, 0.55);
    margin-top: 6px;
  }

  .radar-badge {
    display: inline-block;
    margin-top: 12px;
    background: rgba(224, 89, 44, 0.15);
    border: 1px solid rgba(224, 89, 44, 0.35);
    color: #e8754a;
    border-radius: 8px;
    padding: 5px 11px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
  }

  /* ── recent scans ─────────────────────────────────────────── */
  .radar-scans-wrap {
    padding: 0 16px 16px;
  }

  .radar-scans-head {
    margin-bottom: 6px;
  }

  .radar-rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .radar-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 11px 0;
    border-top: 1px solid rgba(245, 245, 245, 0.07);
  }

  .radar-grade {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border-radius: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
  }

  .radar-path {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 120px;
    flex-shrink: 0;
  }

  .radar-path-seg {
    height: 7px;
    background: rgba(245, 245, 245, 0.14);
    border-radius: 3px;
  }

  .radar-path-slash {
    color: rgba(245, 245, 245, 0.3);
    font-size: 12px;
  }

  .radar-track {
    flex: 1;
    height: 7px;
    background: rgba(245, 245, 245, 0.08);
    border-radius: 4px;
    overflow: hidden;
    min-width: 40px;
  }

  .radar-fill {
    display: block;
    height: 100%;
    border-radius: 4px;
  }

  .radar-pct {
    font-weight: 700;
    font-size: 13px;
    width: 40px;
    text-align: right;
    flex-shrink: 0;
    color: #f5f5f5;
  }

  /* ── responsive ───────────────────────────────────────────── */
  @media (max-width: 760px) {
    .radar-body {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 460px) {
    .radar-path {
      display: none;
    }
  }

  /* ── animations ───────────────────────────────────────────── */
  @keyframes radar-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes radar-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @keyframes radar-blip-glow {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(0.85);
    }
    50% {
      opacity: 1;
      transform: scale(1.15);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .radar-sweep,
    .radar-blip,
    .live-dot {
      animation: none;
    }
    .radar-blip {
      opacity: 0.85;
    }
  }
</style>
