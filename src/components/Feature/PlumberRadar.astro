---
/**
 * * Plumber Radar showcase section.
 * Centered heading + a dark "getplumber.io/radar" dashboard window illustration.
 *
 * The window mirrors the real radar app (plumber-gitlab-ecosystem-scan):
 *   - KPI strip: Projects scanned · Avg score (A–E letter bar) · Total issues
 *     split by severity (Critical / High / Medium / Low).
 *   - Projects table: Nutri-style A–E score, provider, anonymized path, compliance %.
 * It is a self-contained dark mock, so colors are intentionally hard-coded (not
 * theme tokens) and stay dark in both light and dark mode. Figures are a snapshot
 * of the live radar (getplumber.io/radar — /api/stats); refresh them periodically.
 */
import Button from "@components/Button/Button.astro";
import githubIconWhite from "@images/github-icon-white.svg";
import gitlabIcon from "@images/gitlab-icon.svg";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

// Nutri-style grade palette (matches the radar app's score badges)
const GRADE: Record<string, { bg: string; fg: string }> = {
  A: { bg: "#1faa4e", fg: "#fff" },
  B: { bg: "#7bc62d", fg: "#0c0e0c" },
  C: { bg: "#e8c21d", fg: "#0c0e0c" },
  D: { bg: "#ef8a1a", fg: "#0c0e0c" },
  E: { bg: "#df4b2c", fg: "#fff" },
};
const LETTERS = ["A", "B", "C", "D", "E"] as const;

// Aggregate KPIs — snapshot from getplumber.io/radar (/api/stats, all providers)
const projectsScanned = 4122;
const avgScore = "D";
const issueSeverity = [
  { label: "Critical", count: 5312, color: "#df4b2c" },
  { label: "High", count: 43883, color: "#ef8a1a" },
  { label: "Medium", count: 28800, color: "#e8c21d" },
  { label: "Low", count: 5, color: "#a1a1aa" },
];

interface ProjectRow {
  letter: keyof typeof GRADE;
  provider: "gitlab" | "github";
  compliance: number; // 0-100
  segments: [number, number]; // anonymized path segment widths (px)
}

const projectRows: ProjectRow[] = [
  { letter: "A", provider: "gitlab", compliance: 96, segments: [42, 54] },
  { letter: "B", provider: "github", compliance: 82, segments: [50, 46] },
  { letter: "C", provider: "gitlab", compliance: 68, segments: [40, 58] },
  { letter: "D", provider: "github", compliance: 51, segments: [48, 50] },
  { letter: "E", provider: "gitlab", compliance: 29, segments: [44, 52] },
];

function complianceColor(c: number): string {
  if (c >= 100) return "#1a951a";
  if (c >= 75) return "#008700";
  if (c >= 50) return "#e8c21d";
  return "#df4b2c";
}
---

<section
  id="plumber-radar"
  class="border-base-300 dark:border-base-600/60 relative scroll-mt-20 overflow-hidden border-t bg-black/[0.02] dark:bg-white/[0.015]"
>
  <div class="site-container py-24 text-center md:py-32">
    <p class="section-eyebrow" data-mos="fade-up" data-mos-anchor="#plumber-radar">Plumber Radar</p>
    <h2 class="h2 mt-4" data-mos="fade-up" data-mos-delay="0.1" data-mos-anchor="#plumber-radar">
      The state of CI/CD security across <span class="text-primary-500">open source</span>
    </h2>
    <p
      class="description mx-auto mt-4 max-w-xl"
      data-mos="fade-up"
      data-mos-delay="0.2"
      data-mos-anchor="#plumber-radar"
    >
      A free initiative that continuously scans public GitLab and GitHub projects and scores their
      CI/CD security, so the whole ecosystem can see where it stands.
    </p>

    <div
      class="mt-8 flex flex-wrap items-center justify-center gap-4"
      data-mos="fade-up"
      data-mos-delay="0.3"
      data-mos-anchor="#plumber-radar"
    >
      <Button variant="primary" href="/radar" arrow="right">Explore the Radar</Button>
      <a
        href="/radar"
        class="text-base-600 dark:text-base-300 hover:text-primary-600 dark:hover:text-primary-400 inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
      >
        <Icon name="tabler/search" class="h-4 w-4" aria-hidden="true" />
        Scan a public project
      </a>
    </div>

    <!-- dashboard window illustration -->
    <div
      class="radar-window mx-auto mt-12 max-w-[940px] text-left"
      data-mos="fade-up"
      data-mos-delay="0.3"
      data-mos-anchor="#plumber-radar"
    >
      <!-- window header -->
      <div class="radar-bar">
        <span class="radar-tl-dot" style="background:#e0573a"></span>
        <span class="radar-tl-dot" style="background:#e8c21d"></span>
        <span class="radar-tl-dot" style="background:#1faa4e"></span>
        <span class="radar-url">getplumber.io/radar</span>
        <span class="radar-live"><span class="live-dot"></span>LIVE</span>
      </div>

      <!-- KPI strip -->
      <div class="radar-kpis">
        <div class="radar-panel radar-kpi">
          <span class="radar-kpi-label">Projects scanned</span>
          <span class="radar-kpi-value">{projectsScanned.toLocaleString("en-US")}</span>
        </div>

        <div class="radar-panel radar-kpi">
          <span class="radar-kpi-label">Avg score</span>
          <span class="radar-score-bar" role="img" aria-label={`Average Plumber score ${avgScore}`}>
            {
              LETTERS.map((l) => (
                <span
                  class:list={["rs-seg", l === avgScore && "rs-seg--active"]}
                  style={`background:${GRADE[l].bg};color:${GRADE[l].fg}`}
                >
                  {l}
                </span>
              ))
            }
          </span>
        </div>

        <div class="radar-panel radar-kpi">
          <span class="radar-kpi-label">Total issues</span>
          <span class="radar-sev">
            {
              issueSeverity.map((s) => (
                <span
                  class="radar-sev-badge"
                  style={`color:${s.color};border-color:${s.color}55;background:${s.color}1f`}
                >
                  {s.label} {s.count.toLocaleString("en-US")}
                </span>
              ))
            }
          </span>
        </div>
      </div>

      <!-- projects table -->
      <div class="radar-scans-wrap">
        <div class="radar-panel">
          <div class="radar-panel-head radar-scans-head">
            <span class="radar-panel-title">Projects</span>
            <span class="radar-meta">sorted by score</span>
          </div>
          <ul class="radar-rows">
            {
              projectRows.map((row) => (
                <li class="radar-row">
                  <span
                    class="radar-grade"
                    style={`background:${GRADE[row.letter].bg};color:${GRADE[row.letter].fg}`}
                  >
                    {row.letter}
                  </span>
                  <Image
                    src={row.provider === "gitlab" ? gitlabIcon : githubIconWhite}
                    alt={row.provider === "gitlab" ? "GitLab" : "GitHub"}
                    class="radar-row-provider"
                  />
                  <span class="radar-path" aria-hidden="true">
                    <span class="radar-path-seg" style={`width:${row.segments[0]}px`} />
                    <span class="radar-path-slash">/</span>
                    <span class="radar-path-seg" style={`width:${row.segments[1]}px`} />
                  </span>
                  <span class="radar-track">
                    <span
                      class="radar-fill"
                      style={`width:${row.compliance}%;background:${complianceColor(row.compliance)}`}
                    />
                  </span>
                  <span class="radar-pct">{row.compliance}%</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── window shell ─────────────────────────────────────────── */
  .radar-window {
    border: 1px solid rgba(245, 245, 245, 0.12);
    border-radius: 16px;
    background: #080a08;
    overflow: hidden;
    color: rgba(245, 245, 245, 0.9);
    /* Light mode: soft neutral depth + a hint of green. */
    box-shadow:
      0 30px 70px -45px rgba(2, 6, 23, 0.4),
      0 24px 80px -45px rgba(0, 212, 0, 0.18);
  }

  /* Dark mode: prominent directional green glow. */
  :global(.dark) .radar-window {
    box-shadow:
      0 40px 90px -50px rgba(0, 212, 0, 0.3),
      0 20px 60px -35px rgba(0, 0, 0, 0.55);
  }

  /* ── header ───────────────────────────────────────────────── */
  .radar-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid rgba(245, 245, 245, 0.08);
  }

  .radar-tl-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .radar-url {
    font-family: var(--font-mono);
    font-size: 12px;
    color: rgba(245, 245, 245, 0.5);
    margin-left: 6px;
  }

  .radar-live {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid rgba(0, 212, 0, 0.4);
    border-radius: 999px;
    padding: 4px 11px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #00d400;
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00d400;
    box-shadow: 0 0 8px #00d400;
    animation: radar-pulse 1.6s ease-in-out infinite;
  }

  /* ── shared panel ─────────────────────────────────────────── */
  .radar-panel {
    border: 1px solid rgba(245, 245, 245, 0.1);
    border-radius: 12px;
    background: rgba(245, 245, 245, 0.02);
    padding: 16px;
  }

  .radar-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .radar-panel-title {
    font-weight: 700;
    font-size: 15px;
    color: #f5f5f5;
  }

  .radar-meta {
    border: 1px solid rgba(245, 245, 245, 0.12);
    border-radius: 7px;
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgba(245, 245, 245, 0.5);
  }

  /* ── KPI strip ────────────────────────────────────────────── */
  .radar-kpis {
    display: grid;
    grid-template-columns: 0.8fr 1.1fr 1.4fr;
    gap: 14px;
    padding: 16px;
  }

  .radar-kpi {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .radar-kpi-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.45);
  }

  .radar-kpi-value {
    font-weight: 700;
    font-size: 34px;
    line-height: 1;
    color: #f5f5f5;
    margin-top: auto;
  }

  /* avg-score A–E bar (matches the radar app's AvgNutriScoreBar) */
  .radar-score-bar {
    display: flex;
    gap: 3px;
    margin-top: auto;
  }

  .rs-seg {
    flex: 1;
    height: 26px;
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 12px;
    opacity: 0.4;
    transition: none;
  }

  .rs-seg--active {
    opacity: 1;
    height: 32px;
    margin-top: -3px;
    box-shadow: 0 0 0 2px rgba(245, 245, 245, 0.18);
  }

  /* severity badges (matches the app's Critical/High/Medium/Low) */
  .radar-sev {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
  }

  .radar-sev-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    border: 1px solid;
    border-radius: 7px;
    padding: 4px 8px;
    white-space: nowrap;
  }

  /* ── projects table ───────────────────────────────────────── */
  .radar-scans-wrap {
    padding: 0 16px 16px;
  }

  .radar-scans-head {
    margin-bottom: 6px;
  }

  .radar-rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .radar-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 0;
    border-top: 1px solid rgba(245, 245, 245, 0.07);
  }

  .radar-grade {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border-radius: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
  }

  .radar-row-provider {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    opacity: 0.85;
  }

  .radar-path {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 110px;
    flex-shrink: 0;
  }

  .radar-path-seg {
    height: 7px;
    background: rgba(245, 245, 245, 0.14);
    border-radius: 3px;
  }

  .radar-path-slash {
    color: rgba(245, 245, 245, 0.3);
    font-size: 12px;
  }

  .radar-track {
    flex: 1;
    height: 7px;
    background: rgba(245, 245, 245, 0.08);
    border-radius: 4px;
    overflow: hidden;
    min-width: 40px;
  }

  .radar-fill {
    display: block;
    height: 100%;
    border-radius: 4px;
  }

  .radar-pct {
    font-weight: 700;
    font-size: 13px;
    width: 40px;
    text-align: right;
    flex-shrink: 0;
    color: #f5f5f5;
  }

  /* ── responsive ───────────────────────────────────────────── */
  @media (max-width: 760px) {
    .radar-kpis {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 460px) {
    .radar-path {
      display: none;
    }
  }

  /* ── animations ───────────────────────────────────────────── */
  @keyframes radar-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-dot {
      animation: none;
    }
  }
</style>
