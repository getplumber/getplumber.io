---
/**
 * "Why CI/CD security matters" — a single illustrated "coverage map" scene.
 *
 * A dark dashboard window (same visual language as the radar mock) shows the
 * software path as three stations. All three chips speak the same language —
 * the tooling available for that stage: SAST/SCA and DAST/logs floodlight the
 * ends, "No tool · manual checks" marks the dark middle. The AI angle lives in
 * the heading and the takeaway (not in the scene), and the dense commit flow
 * crossing the unwatched middle carries the volume. One look: lit, dark, lit.
 *
 * The window is a self-contained dark mock, so colors are hard-coded (not
 * theme tokens) and read identically in light and dark mode. The accent
 * palette mirrors the hero animation (greens #00e000/#3bff6a, red #ff2d3d)
 * so both scenes read as one system; the canvas sits a shade darker than
 * the dark-mode section background rather than pure animation black.
 */
import { Icon } from "astro-icon/components";
---

<section
  id="why-security"
  class="section-alt border-base-300 dark:border-base-600/60 scroll-mt-20 border-t py-20 md:py-28"
>
  <div class="site-container text-center">
    <p class="section-eyebrow" data-mos="fade-up" data-mos-anchor="#why-security">Why it matters</p>
    <h2 class="h2 mt-4" data-mos="fade-up" data-mos-delay="0.1" data-mos-anchor="#why-security">
      CI/CD: the <span class="text-primary-500">blind spot</span> AI is making bigger every day
    </h2>
    <p
      class="description mt-3"
      data-mos="fade-up"
      data-mos-delay="0.2"
      data-mos-anchor="#why-security"
    >
      Unwatched. Under attack. AI-fueled.
    </p>

    <!-- coverage-map window -->
    <div
      class="wsb-window mx-auto mt-12 text-left"
      data-mos="fade-up"
      data-mos-delay="0.3"
      data-mos-anchor="#why-security"
    >
      <!-- window header -->
      <div class="wsb-bar">
        <span class="wsb-dot" style="background:#ff2d3d"></span>
        <span class="wsb-dot" style="background:#e8c21d"></span>
        <span class="wsb-dot" style="background:#00e000"></span>
        <span class="wsb-url">the-security-industry</span>
        <span class="wsb-badge"><span class="wsb-badge-dot"></span>2/3 STAGES COVERED</span>
      </div>

      <!-- stage -->
      <div class="wsb-stage">
        <!-- pipeline track + flowing commits (desktop) -->
        <div class="wsb-track" aria-hidden="true"></div>
        <span class="wsb-flow" style="animation-delay:0s" aria-hidden="true"></span>
        <span class="wsb-flow" style="animation-delay:-1.4s" aria-hidden="true"></span>
        <span class="wsb-flow" style="animation-delay:-2.8s" aria-hidden="true"></span>
        <span class="wsb-flow" style="animation-delay:-4.2s" aria-hidden="true"></span>
        <span class="wsb-flow" style="animation-delay:-5.6s" aria-hidden="true"></span>
        <!-- (each .wsb-flow is a full-width invisible rail whose ::before dot
             rides along as the rail translates; transform-only, no reflow) -->

        <div class="wsb-grid">
          <!-- station: code (lit) -->
          <div class="wsb-col">
            <div class="wsb-top">
              <span class="wsb-chip wsb-chip--tool">
                <Icon name="tabler/shield-check" class="wsb-ic" aria-hidden="true" />
                SAST · SCA
              </span>
              <div class="wsb-cone" aria-hidden="true"></div>
            </div>
            <div class="wsb-node wsb-node--lit">
              <span class="wsb-name">Your code</span>
              <span class="wsb-status wsb-status--ok">
                <Icon name="tabler/check" class="wsb-ic-s" aria-hidden="true" />
                watched
              </span>
            </div>
          </div>

          <!-- station: CI/CD (dark) -->
          <div class="wsb-col">
            <div class="wsb-top">
              {/* same register as the SAST/DAST chips: this names the (missing)
                  tooling for the stage, not a threat — the AI angle lives in
                  the heading and the takeaway line instead */}
              <span class="wsb-chip wsb-chip--gap">
                <Icon name="tabler/alert-triangle" class="wsb-ic" aria-hidden="true" />
                No tool · manual checks
              </span>
            </div>
            <div class="wsb-node wsb-node--blind">
              <span class="wsb-name">CI/CD pipeline</span>
              <span class="wsb-status wsb-status--bad">
                <Icon name="tabler/alert-triangle" class="wsb-ic-s" aria-hidden="true" />
                unwatched
              </span>
            </div>
          </div>

          <!-- station: runtime (lit) -->
          <div class="wsb-col">
            <div class="wsb-top">
              <span class="wsb-chip wsb-chip--tool">
                <Icon name="tabler/shield-check" class="wsb-ic" aria-hidden="true" />
                DAST · logs
              </span>
              <div class="wsb-cone" aria-hidden="true"></div>
            </div>
            <div class="wsb-node wsb-node--lit">
              <span class="wsb-name">Your runtime</span>
              <span class="wsb-status wsb-status--ok">
                <Icon name="tabler/check" class="wsb-ic-s" aria-hidden="true" />
                watched
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <p
      class="text-base-600 dark:text-base-400 mx-auto mt-8 max-w-xl text-sm leading-relaxed"
      data-mos="fade-up"
      data-mos-delay="0.4"
      data-mos-anchor="#why-security"
    >
      AI has industrialized code production. Every line, human or machine, still ships through
      the one stage nobody watches: your CI/CD pipeline.
    </p>
  </div>
</section>

<style>
  /* ── window shell (same language as the radar mock) ─────────── */
  .wsb-window {
    border: 1px solid rgba(245, 245, 245, 0.12);
    border-radius: 16px;
    /* a shade darker than the dark-mode section background (zinc-900 #18181b)
       so the window sits close to the page instead of punching a black hole */
    background: #101114;
    overflow: hidden;
    color: rgba(245, 245, 245, 0.9);
    box-shadow:
      0 30px 70px -45px rgba(2, 6, 23, 0.4),
      0 24px 80px -45px rgba(0, 212, 0, 0.18);
  }

  :global(.dark) .wsb-window {
    box-shadow:
      0 40px 90px -50px rgba(0, 212, 0, 0.3),
      0 20px 60px -35px rgba(0, 0, 0, 0.55);
  }

  .wsb-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid rgba(245, 245, 245, 0.08);
  }

  .wsb-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .wsb-url {
    font-family: var(--font-mono);
    font-size: 12px;
    color: rgba(245, 245, 245, 0.5);
    margin-left: 6px;
  }

  .wsb-badge {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid rgba(232, 194, 29, 0.4);
    border-radius: 999px;
    padding: 4px 11px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #e8c21d;
    white-space: nowrap;
  }

  .wsb-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #e8c21d;
    box-shadow: 0 0 8px #e8c21d;
    animation: wsb-pulse 1.6s ease-in-out infinite;
  }

  /* ── stage ──────────────────────────────────────────────────── */
  .wsb-stage {
    position: relative;
    padding: 26px 24px 28px;
  }

  .wsb-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .wsb-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* top zone: fixed height so the three nodes align on one baseline */
  .wsb-top {
    height: 128px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  /* ── chips (scanners shine light, threats pour in) ──────────── */
  .wsb-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid;
    border-radius: 999px;
    padding: 4px 11px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* palette matches the hero animation: green #00e000 / #3bff6a, red #ff2d3d */
  .wsb-chip--tool {
    border-color: rgba(0, 224, 0, 0.35);
    background: rgba(0, 224, 0, 0.1);
    color: #3bff6a;
  }

  /* the tooling gap: same register as the tool chips, but red and dashed —
     "here, no tool exists" */
  .wsb-chip--gap {
    border-color: rgba(255, 45, 61, 0.5);
    border-style: dashed;
    background: rgba(255, 45, 61, 0.08);
    color: #ff2d3d;
  }

  .wsb-ic {
    width: 14px;
    height: 14px;
  }

  .wsb-ic-s {
    width: 12px;
    height: 12px;
  }

  /* ── floodlight cones over the covered stations ─────────────── */
  .wsb-cone {
    flex: 1;
    width: 100%;
    clip-path: polygon(44% 0%, 56% 0%, 100% 100%, 0% 100%);
    background: linear-gradient(to bottom, rgba(0, 224, 0, 0.24), rgba(0, 224, 0, 0.02));
  }

  /* ── stations ───────────────────────────────────────────────── */
  .wsb-node {
    min-height: 88px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-radius: 14px;
    padding: 14px 12px;
    text-align: center;
  }

  .wsb-node--lit {
    border: 1px solid rgba(0, 224, 0, 0.3);
    background: rgba(0, 224, 0, 0.06);
  }

  .wsb-node--blind {
    border: 1.5px dashed rgba(255, 45, 61, 0.6);
    background: rgba(255, 45, 61, 0.07);
    box-shadow: 0 0 44px -12px rgba(255, 45, 61, 0.65);
  }

  .wsb-name {
    color: #f5f5f5;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .wsb-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .wsb-status--ok {
    color: #3bff6a;
  }

  .wsb-status--bad {
    color: #ff2d3d;
  }

  /* ── pipeline track + flowing commits (desktop) ─────────────── */
  .wsb-track {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 72px;
    height: 1px;
    background: rgba(245, 245, 245, 0.08);
  }

  /* Invisible full-width rail; translating it by 100% of its own width walks
     the dot (::before) across the whole track. Compositor-only animation. */
  .wsb-flow {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 70px;
    height: 5px;
    pointer-events: none;
    animation: wsb-flow 7s linear infinite;
  }

  .wsb-flow::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #3bff6a;
    box-shadow: 0 0 6px rgba(59, 255, 106, 0.8);
    opacity: 0.75;
    /* same 7s clock as the rail (delay inherited from the rail's inline
       animation-delay) so the dot turns red while inside the middle column,
       matching the unmonitored CI/CD card it is passing through */
    animation: wsb-flow-color 7s linear infinite;
    animation-delay: inherit;
  }

  /* ── responsive: stack the scene vertically ─────────────────── */
  @media (max-width: 767px) {
    .wsb-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .wsb-top {
      height: auto;
    }

    .wsb-cone {
      flex: none;
      height: 44px;
    }

    /* the lit columns get breathing room from their 44px cones; the middle
       column has no cone, so give the gap chip its own spacing to the card */
    .wsb-chip--gap {
      margin-bottom: 16px;
    }

    .wsb-track,
    .wsb-flow {
      display: none;
    }

    .wsb-badge {
      font-size: 10px;
      padding: 3px 9px;
    }
  }

  /* ── animations ─────────────────────────────────────────────── */
  @keyframes wsb-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @keyframes wsb-flow {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(100%);
    }
  }

  /* the middle (CI/CD) column spans roughly 34%–66% of the track: green
     while covered, red while crossing the unmonitored pipeline */
  @keyframes wsb-flow-color {
    0%,
    33% {
      background: #3bff6a;
      box-shadow: 0 0 6px rgba(59, 255, 106, 0.8);
    }
    37%,
    63% {
      background: #ff2d3d;
      box-shadow: 0 0 6px rgba(255, 45, 61, 0.8);
    }
    67%,
    100% {
      background: #3bff6a;
      box-shadow: 0 0 6px rgba(59, 255, 106, 0.8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wsb-badge-dot {
      animation: none;
    }

    .wsb-flow {
      display: none;
    }
  }
</style>
