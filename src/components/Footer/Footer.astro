---
import FooterLink from "@components/Footer/FooterLink.astro";
import { footerColumns, footerSocials } from "@config/en/homeData.json";
import { Icon } from "astro-icon/components";

const year = new Date().getFullYear();
const isDocs = Astro.url.pathname.startsWith("/docs");
---

<footer class="bg-background stroke-tint border-t">
  <div class:list={[isDocs ? "docs-site-container" : "home-container", "pt-16 pb-8"]}>
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[repeat(4,minmax(0,1fr))_minmax(0,1.6fr)]">
      {footerColumns.map((column) => (
        <div class="flex flex-col gap-3">
          <h3 class="subtitle text-foreground">{column.title}</h3>
          {column.links.map((item) => (
            <FooterLink href={item.link} newTab={item.newTab}>
              {item.text}
            </FooterLink>
          ))}
        </div>
      ))}

      <div class="flex flex-col gap-4 sm:col-span-2 lg:col-span-1">
        <h3 class="subtitle text-foreground">Newsletter</h3>
        <form
          data-form="newsletter"
          action="/api/newsletter"
          method="post"
          class="flex flex-col gap-3"
          novalidate
        >
          <label class="sr-only" for="newsletter-email">
            Your email
          </label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="Your email"
            class="form__input"
          />
          <input
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            class="hidden"
            aria-hidden="true"
          />
          <button type="submit" class="button button--secondary-trailing self-start">
            Subscribe
          </button>
          <p data-form-status class="body-sm text-muted-foreground min-h-5" aria-live="polite"></p>
        </form>
        <ul class="flex items-center gap-5" aria-label="Social links">
          {footerSocials.map((social) => (
            <li>
              <a
                href={social.link}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.text}
                class="text-muted-foreground hover:text-foreground primary-focus flex h-8 w-8 items-center justify-center transition"
              >
                <Icon name={social.icon} class="size-5" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="body-sm text-muted-foreground mt-12 flex flex-wrap gap-x-3 gap-y-1">
      <span>&copy;PLUMBER {year}</span>
      <span aria-hidden="true">&middot;</span>
      <span>All rights reserved</span>
      <span aria-hidden="true">&middot;</span>
      <a href="/privacy-policy" class="hover:text-foreground transition">
        Cookies
      </a>
    </p>

    <p
      class="font-heading text-foreground mt-10 overflow-hidden text-right text-[clamp(3.5rem,12.2vw,11rem)] leading-none tracking-[-0.02em]"
      aria-hidden="true"
    >
      PLUMBER
    </p>
  </div>
</footer>
