---
import Button from "@components/Button/Button.astro";
import GitHubHeroStatsBadge from "@components/Hero/GitHubHeroStatsBadge.astro";
import githubBlackLogo from "@images/github-black.svg";
import githubWhiteLogo from "@images/github-white.svg";
import gitlabDarkLogo from "@images/gitlab-dark.svg";
import gitlabWhiteLogo from "@images/gilab-white.svg";
import { Image } from "astro:assets";
---

<section
  id="plumber-hero"
  class="relative flex w-full overflow-hidden pt-28 pb-20 md:pt-36 md:pb-24"
>
  <!-- hero items -->
  <div class="site-container mx-auto max-w-6xl min-w-0">
    <div class="min-w-0 px-1 text-center sm:px-0">
      <!-- GitHub stars + latest release pill -->
      <div class="mb-6 flex justify-center">
        <GitHubHeroStatsBadge />
      </div>

      <!-- eyebrow -->
      <p
        class="section-eyebrow"
        data-mos="fade-up"
        data-mos-anchor="#plumber-hero"
      >
        Open source · CI/CD security
      </p>

      <h1
        class="from-base-900 to-base-600/90 dark:from-base-100 dark:to-base-400/90 text-pretty mx-auto mt-5 max-w-3xl bg-gradient-to-r bg-clip-text pb-2 text-4xl leading-[1.1] font-semibold tracking-tight text-transparent sm:text-5xl md:text-6xl"
        data-mos="fade-up"
        data-mos-delay="0.1"
        data-mos-anchor="#plumber-hero"
      >
        Spot &amp; fix CI/CD security leaks, <span
          class="text-primary-600 dark:text-primary-500 dark:text-shadow-base-700 dark:text-shadow-xs"
          >continuously</span
        >
      </h1>

      <p
        class="description mx-auto mt-6 max-w-2xl"
        data-mos="fade-up"
        data-mos-delay="0.2"
        data-mos-anchor="#plumber-hero"
      >
        The open-source tool that maps your pipelines, detects the leaks attackers look for, and
        grades your CI/CD security in seconds.
      </p>

      <!-- CTA -->
      <div
        class="mx-auto mt-8 flex max-w-md flex-col justify-center gap-4 px-4 sm:flex-row"
        data-mos="fade-up"
        data-mos-delay="0.3"
        data-mos-anchor="#plumber-hero"
      >
        <Button variant="primary" href="/docs/cli/installation" arrow="right">
          Install the CLI
        </Button>
      </div>

      <!-- Provider logos: official wordmarks for GitLab and GitHub -->
      <div
        class="text-base-500 dark:text-base-400 mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-xs font-medium tracking-wider uppercase"
        data-mos="fade-up"
        data-mos-delay="0.4"
        data-mos-anchor="#plumber-hero"
        aria-label="Supported CI/CD providers"
      >
        <span aria-hidden="true">Works with</span>
        <span class="inline-flex items-center gap-5">
          <Image
            src={gitlabDarkLogo}
            alt="GitLab"
            class="block h-5 w-auto opacity-80 dark:hidden"
            loading="eager"
          />
          <Image
            src={gitlabWhiteLogo}
            alt="GitLab"
            class="hidden h-5 w-auto opacity-80 dark:block"
            loading="eager"
          />
          <span class="bg-base-600 dark:bg-base-500 inline-block h-6 w-px" aria-hidden="true"></span>
          <Image
            src={githubBlackLogo}
            alt="GitHub"
            class="block h-5 w-auto opacity-90 dark:hidden"
            loading="eager"
          />
          <Image
            src={githubWhiteLogo}
            alt="GitHub"
            class="hidden h-5 w-auto opacity-90 dark:block"
            loading="eager"
          />
        </span>
      </div>
    </div>
  </div>
</section>
