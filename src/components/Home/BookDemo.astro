---
/**
 * "Find the leak before an attacker does" (Figma HOME_Last, node 2513:1886, 1440 x 410).
 * Copy on the left, a four-field form on the right. The form posts to /api/demo through
 * src/js/forms.ts.
 */
import { bookDemo } from "@config/en/homeData.json";

import SectionHeading from "./SectionHeading.astro";

const { fields } = bookDemo;
---

<section id="book-a-demo" class="bg-background scroll-mt-[78px]">
  <div
    class="home-container section-y grid gap-16 lg:grid-cols-[minmax(0,534fr)_minmax(0,138fr)_minmax(0,648fr)]"
    data-reveal
  >
    <SectionHeading
      eyebrow={bookDemo.eyebrow}
      headline={bookDemo.headline}
      headlineStrong={bookDemo.headlineStrong}
      text={bookDemo.text}
      class="[&>p:last-child]:max-w-none"
    />

    <form
      data-form="demo"
      action="/api/demo"
      method="post"
      class="flex flex-col gap-16 lg:col-start-3"
      novalidate
    >
      <div class="flex flex-col">
        <label class="sr-only" for="demo-name">
          {fields.name}
        </label>
        <input
          id="demo-name"
          name="name"
          type="text"
          autocomplete="name"
          required
          minlength="2"
          maxlength="100"
          placeholder={fields.name}
          class="form__input form__input--row"
        />
        <label class="sr-only" for="demo-email">
          {fields.email}
        </label>
        <input
          id="demo-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          maxlength="200"
          placeholder={fields.email}
          class="form__input form__input--row"
        />
        <label class="sr-only" for="demo-company">
          {fields.company}
        </label>
        <input
          id="demo-company"
          name="company"
          type="text"
          autocomplete="organization"
          required
          maxlength="100"
          placeholder={fields.company}
          class="form__input form__input--row"
        />
        <label class="sr-only" for="demo-pipelines">
          {fields.pipelines}
        </label>
        <input
          id="demo-pipelines"
          name="pipelines"
          type="text"
          inputmode="numeric"
          maxlength="50"
          placeholder={fields.pipelines}
          class="form__input form__input--row"
        />
        <input
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          class="hidden"
          aria-hidden="true"
        />
      </div>

      <div class="flex flex-col gap-4">
        <button type="submit" class="button button--primary button--marker-trailing w-full">
          {bookDemo.submit}
        </button>
        <p data-form-status class="body-sm text-muted-foreground min-h-5" aria-live="polite"></p>
      </div>
    </form>
  </div>
</section>

<style>
  /* Figma field rows (review of 2026-11-25): 16/150 Regular text in #8D9596, 32px vertical
     padding, 25 percent stroke; 64px down to the button */
  .form__input--row {
    padding-block: 32px;
    font-size: 1rem;
    line-height: 1.5;
    font-weight: 400;
  }
  .form__input--row::placeholder {
    color: var(--muted-foreground);
    font-weight: 400;
  }
  .form__input--row[aria-invalid="true"] {
    border-color: var(--color-danger-500);
  }
</style>
