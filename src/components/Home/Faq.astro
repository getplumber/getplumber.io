---
/**
 * "Questions" (Figma HOME_Last, node 2513:1845, 1440 x 898).
 * Accordion on the Starwind primitive: items separated by tint strokes. New design of
 * 2026-11-25: 20/150 grey questions with the large accent pixel chevron (down); a hovered
 * item, its open answer included, turns accent blue with near-black text and chevron; the
 * open question and its chevron (up) are white over the #C6C6C6 answer. Every item starts
 * closed. Below lg the rows have no side padding, like the coverage overview row.
 * Also emits the FAQPage JSON-LD for search engines.
 */
import Accordion from "@components/starwind/accordion/Accordion.astro";
import AccordionContent from "@components/starwind/accordion/AccordionContent.astro";
import AccordionItem from "@components/starwind/accordion/AccordionItem.astro";
import AccordionTrigger from "@components/starwind/accordion/AccordionTrigger.astro";
import { faqData } from "@config/en/faqData.json";
import { faqSection } from "@config/en/homeData.json";
import { Icon } from "astro-icon/components";

import SectionHeading from "./SectionHeading.astro";

const stripHtml = (html: string) =>
  html
    .replace(/<[^>]+>/g, "")
    .replace(/\s+/g, " ")
    .trim();

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqData.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: stripHtml(item.answer) },
  })),
}).replace(/</g, "\\u003c");
---

<section id="faq" class="bg-background">
  <div class="home-container section-y flex flex-col gap-16" data-reveal>
    <SectionHeading eyebrow={faqSection.eyebrow} headline={faqSection.headline} class="gap-5" />

    <Accordion type="single" class="faq stroke-tint border-b">
      {faqData.map((item, i) => (
        <AccordionItem
          value={`faq-${i}`}
          class="faq__item stroke-tint rounded-none border-0 border-t"
        >
          <AccordionTrigger class="faq__trigger rounded-none px-0 py-8 text-xl leading-[1.5] font-normal lg:px-8 [&>svg:last-child]:hidden">
            <span class="faq__question">{item.question}</span>
            <Icon name="pixel/chevron-lg" class="faq__chevron chevron-lg" aria-hidden="true" />
          </AccordionTrigger>
          <AccordionContent details={item.answer} class="faq__content" />
        </AccordionItem>
      ))}
    </Accordion>
  </div>
</section>

<script type="application/ld+json" set:html={faqJsonLd} is:inline />
<style>
  :global(.faq__trigger) {
    color: var(--muted-foreground);
    transition:
      background-color 250ms ease,
      color 250ms ease;
  }
  :global(.faq__chevron) {
    color: var(--accent-text);
    rotate: 90deg;
    transition:
      color 250ms ease,
      rotate 250ms ease;
  }
  :global(.faq__trigger[data-state="open"]) {
    color: var(--foreground);
  }
  :global(.faq__trigger[data-state="open"] .faq__chevron) {
    color: var(--foreground);
    rotate: -90deg;
  }
  /* the hover tint covers the whole item, the open answer included, with near-black text */
  :global(.faq__item),
  :global(.faq__content > div),
  :global(.faq__content a) {
    transition:
      background-color 250ms ease,
      color 250ms ease;
  }
  @media (hover: hover) {
    :global(.faq__item:hover) {
      background-color: var(--color-primary-500);
    }
    :global(.faq__item:hover .faq__trigger),
    :global(.faq__item:hover .faq__chevron),
    :global(.faq__item:hover .faq__content > div),
    :global(.faq__item:hover .faq__content a) {
      color: var(--color-base-950);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.faq__item),
    :global(.faq__trigger),
    :global(.faq__chevron),
    :global(.faq__content > div),
    :global(.faq__content a) {
      transition: none;
    }
  }
  :global(.faq__content > div) {
    padding: 0 32px 32px;
    max-width: 1207px;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-base-600);
  }
  :global(.dark .faq__content > div) {
    color: var(--color-base-200);
  }
  :global(.faq__content a) {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* below lg the rows sit flush with the container, like the coverage overview row */
  @media (max-width: 1023px) {
    :global(.faq__content > div) {
      padding-left: 0;
      padding-right: 0;
    }
  }
</style>
