---
/**
 * * Open source adopters row
 *
 * Projects with 2k+ stars whose GitHub workflows run the Plumber Action.
 * adopters.json is regenerated on every build by scripts/fetch-adopters.js
 * (committed snapshot as fallback); adopters.overrides.json holds the hand
 * edits: owners to hide, and a label or logo when the GitHub avatar is a
 * personal photo rather than a project logo.
 */
import { Icon } from "astro-icon/components";

import adopters from "@/data/adopters.json";
import overrides from "@/data/adopters.overrides.json";

type Override = { name?: string; logo?: string };
const ownerOverrides: Record<string, Override> = overrides.owners;
const excluded = new Set(overrides.exclude.map((o: string) => o.toLowerCase()));

const items = adopters
  .filter((a) => !excluded.has(a.owner.toLowerCase()))
  .map((a) => {
    const o = ownerOverrides[a.owner.toLowerCase()] ?? {};
    return {
      ...a,
      name: o.name ?? a.name,
      logo: o.logo ?? `${a.avatar}?s=96`,
    };
  });

const formatStars = (n: number) =>
  n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, "")}k` : String(n);
---

{items.length > 0 && (
  <section
    id="oss-adopters"
    class="border-base-300 dark:border-base-600/60 border-b py-8"
    data-mos="fade"
    data-mos-anchor="#oss-adopters"
  >
    <div class="site-container">
      <p class="text-base-600 dark:text-base-400 text-center text-sm">
        Running in the CI of open source projects like
      </p>
      <ul class="mt-5 flex flex-wrap items-center justify-center gap-x-8 gap-y-5 sm:gap-x-10">
        {items.map((a) => (
          <li>
            <a
              href={a.url}
              target="_blank"
              rel="noopener noreferrer"
              title={`${a.repo} on GitHub`}
              class="group text-base-700 dark:text-base-200 inline-flex items-center gap-2.5 transition"
            >
              <img
                src={a.logo}
                alt=""
                width="32"
                height="32"
                loading="lazy"
                decoding="async"
                class="ring-base-300 dark:ring-base-600 h-8 w-8 rounded-md bg-white ring-1 grayscale transition group-hover:grayscale-0"
              />
              <span class="flex flex-col leading-tight">
                <span class="group-hover:text-primary-600 dark:group-hover:text-primary-400 text-sm font-semibold">
                  {a.name}
                </span>
                <span class="text-base-500 dark:text-base-400 inline-flex items-center gap-1 text-xs tabular-nums">
                  <Icon
                    name="tabler/star-filled"
                    class="h-3 w-3 text-amber-400"
                    aria-hidden="true"
                  />
                  {formatStars(a.stars)}
                  <span class="sr-only">GitHub stars</span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
