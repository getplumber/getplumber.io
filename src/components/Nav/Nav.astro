---
import Button from "@components/Button/Button.astro";
import MobileNav from "@components/Nav/MobileNav/MobileNav.astro";
import NavLink from "@components/Nav/NavLink.astro";
import SiteLogo from "@components/SiteLogo/SiteLogo.astro";
import ThemeToggle from "@components/ThemeToggle/ThemeToggle.astro";
import { navCtas } from "@config/en/navData.json";
import { getLocaleFromUrl } from "@js/localeUtils";
import { PLUMBER_GITHUB_REPO_URL } from "@js/plumberGithubRepo";
import { getTranslatedData } from "@js/translationUtils";
import { Icon } from "astro-icon/components";

const currLocale = getLocaleFromUrl(Astro.url);
const navData = getTranslatedData("navData", currLocale);
// items flagged "hidden" stay in the data until their page exists
const navItems = navData.filter((item) => !("hidden" in item && item.hidden));
const isDocs = Astro.url.pathname.startsWith("/docs");
---

<section
  id="nav"
  class:list={[
    "fixed top-0 left-0 z-30 w-full border-b transition-all duration-300",
    // docs pages always get an opaque background so content never shows through
    isDocs ? "bg-background/80 border-foreground/10 backdrop-blur" : "navbar--initial",
  ]}
>
  <div
    class:list={[
      isDocs ? "docs-site-container border-foreground/10 border-r border-l" : "home-container",
    ]}
  >
    <header class="flex h-[76px] items-center gap-6">
      <!-- home button / logo -->
      <div class="flex flex-none items-center">
        <SiteLogo />
      </div>

      <!-- desktop nav links -->
      <nav class="hidden flex-1 lg:block" aria-label="Main">
        <ul class="flex items-center gap-1">
          {navItems.map((navItem) => "link" in navItem && <NavLink {navItem} />)}
        </ul>
      </nav>

      <!-- desktop actions -->
      <div class="ml-auto hidden items-center gap-3 lg:flex">
        <ThemeToggle />
        <a
          href={PLUMBER_GITHUB_REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Plumber on GitHub"
          class="primary-focus nav__link--base flex h-9 w-9 items-center justify-center"
        >
          <Icon name="mdi/github" class="size-6" aria-hidden="true" />
        </a>
        {navCtas.map((cta) => (
          <Button
            variant={cta.variant}
            size="navbar"
            href={cta.link}
            target={cta.newTab ? "_blank" : undefined}
            rel={cta.newTab ? "noopener noreferrer" : undefined}
          >
            {cta.text}
          </Button>
        ))}
      </div>

      <!-- mobile nav menu, only load on small screens where it is visible -->
      <div class="ml-auto flex items-center lg:hidden">
        <MobileNav />
      </div>
    </header>
  </div>
</section>

<style>
  @import "tailwindcss/theme" theme(reference);
  @import "@/styles/tailwind-theme.css" theme(reference);

  .navbar--scrolled {
    @apply bg-background/80 backdrop-blur;
    border-color: var(--color-tint-25);
  }

  .navbar--initial {
    @apply bg-background;
    border-color: var(--color-tint-25);
  }
</style>

{/* script on scrolldown to make navbar translucent and frosted */}
<script>
  let navbar: HTMLElement | null;

  function scrollHandler() {
    if (navbar) {
      const isDocsPage = window.location.pathname.startsWith("/docs");

      if (window.scrollY > 50) {
        if (!isDocsPage) {
          navbar.classList.add("navbar--scrolled");
          navbar.classList.remove("navbar--initial");
        }
      } else {
        if (!isDocsPage) {
          navbar.classList.add("navbar--initial");
          navbar.classList.remove("navbar--scrolled");
        }
      }
    }
  }

  function initNav() {
    navbar = document.getElementById("nav");
    window.addEventListener("scroll", scrollHandler, { passive: true });
  }

  // runs on initial page load
  initNav();

  // runs on view transitions navigation
  document.addEventListener("astro:after-swap", initNav);
</script>
