---
import { type navLinkItem } from "@config/types/configDataTypes";
import { getLocaleFromUrl } from "@js/localeUtils";
import { Icon } from "astro-icon/components";

/**
 * Compares two paths ensuring they both have trailing slashes for consistency
 * @param path1 First path to compare
 * @param path2 Second path to compare
 * @returns boolean indicating if the paths are equal
 */
const comparePathsWithTrailingSlash = (path1: string, path2: string): boolean => {
  const ensureTrailingSlash = (path: string): string => (path.endsWith("/") ? path : `${path}/`);

  return ensureTrailingSlash(path1) === ensureTrailingSlash(path2);
};

interface Props {
  navItem: navLinkItem;
  class?: string;
  icon?: string;
  noIcon?: boolean;
}

const { navItem, class: className, noIcon = false } = Astro.props as Props;
const { text, link, newTab = false, icon } = navItem;

// get the current page locale to use in links to other pages
const currLocale = getLocaleFromUrl(Astro.url);

const domain = import.meta.env.SITE; // pulls from astro.config.mjs
let actualLink: string;
if (!link.includes(domain) && !link.startsWith("/") && !link.startsWith("#")) {
  // it is an external link
  actualLink = link;
} else {
  // internal link - normalize to remove trailing slash (except root)
  actualLink = link === "/" ? "/" : link.replace(/\/$/, "");
}

// determine if this nav item should be highlighted as active
const isActive = actualLink.startsWith("/docs")
  ? Astro.url.pathname.startsWith("/docs")
  : actualLink === "/blog"
    ? Astro.url.pathname.startsWith("/blog")
    : comparePathsWithTrailingSlash(Astro.url.pathname, actualLink);
---

<li class="w-full">
  <a
    class:list={[
      `nav-link primary-focus text-muted-foreground hover:text-foreground focus-visible:text-foreground relative flex shrink-0 items-center gap-1.5 py-2 leading-tight whitespace-nowrap transition-colors duration-300 ${className}`,
      {
        // the current page keeps the hover look: foreground text and the accent underline
        "nav-link--active text-foreground": isActive,
      },
    ]}
    href={actualLink}
    target={newTab ? "_blank" : ""}
    rel={newTab ? "noopener noreferrer" : ""}
    aria-label={text}
  >
    {icon && !noIcon && <Icon name={icon} aria-hidden="true" class="nav:block hidden size-4" />}

    {text}
  </a>
</li>

<style>
  /* Figma Component_Menu hover: foreground text with a 2px accent underline that grows from
     the left; the current page shows the underline at rest */
  .nav-link::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    background-color: var(--color-primary-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 300ms ease;
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link--active::after {
    transform: scaleX(1);
  }
</style>
