---
import { Image } from "astro:assets";
import avatar from "@/data/authors/stephane-robert/avatar.png";

interface Props {
  /** URL of the original (French) article on the author's blog. */
  href: string;
  /** Author display name. */
  name?: string;
  /** Author role / title shown under the name. */
  role?: string;
  /** Human-readable site label shown under the name. */
  site?: string;
}

const {
  href,
  name = "Stéphane Robert",
  role = "DevSecOps Architect",
  site = "blog.stephane-robert.info",
} = Astro.props as Props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="original-author not-prose group my-6 block max-w-xl rounded-xl border border-border bg-card p-5 no-underline transition-colors hover:border-primary"
>
  <div class="flex items-start gap-4">
    <Image
      src={avatar}
      alt={name}
      width={128}
      height={128}
      loading="eager"
      class="h-16 w-16 shrink-0 rounded-full object-cover ring-2 ring-primary"
    />
    <div class="min-w-0">
      <p class="text-muted-foreground text-xs font-semibold tracking-wide uppercase">
        Originally written in French by
      </p>
      <p class="text-foreground text-lg font-bold leading-tight">{name}</p>
      <p class="text-muted-foreground text-sm">{role}</p>
    </div>
  </div>

  <div class="border-border mt-4 flex flex-wrap items-center justify-between gap-2 border-t pt-3">
    <p class="text-muted-foreground text-xs">
      Republished in English with permission. The first-person "I" is {name}'s.
    </p>
    <span
      class="bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-foreground inline-flex shrink-0 items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-semibold transition-colors"
    >
      Read on {site}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M11 7H7a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-4"></path>
        <path d="M14 4h6v6"></path>
        <path d="M10 14 20 4"></path>
      </svg>
    </span>
  </div>
</a>
