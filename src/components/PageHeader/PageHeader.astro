---
/**
 * Page header shared by the blog, archive and error pages: pixel eyebrow with a 6px
 * teal square, uppercase H1 and an optional lead paragraph (same block as the docs pages).
 */
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  class?: string;
}

const { eyebrow, title, lead, class: className } = Astro.props;
---

<header class:list={["flex max-w-[786px] flex-col gap-6", className]}>
  {eyebrow && (
    <p class="eyebrow flex items-center gap-2">
      <span class="eyebrow-dot" aria-hidden="true" />
      {eyebrow}
    </p>
  )}
  <h1 class="h1 text-foreground uppercase">{title}</h1>
  {lead && <p class="body-lg text-muted-foreground">{lead}</p>}
  <slot />
</header>
