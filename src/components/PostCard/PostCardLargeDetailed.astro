---
import { getLocaleFromUrl } from "@js/localeUtils";
import { formatDate } from "@js/textUtils";
import { Image } from "astro:assets";
import { type CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
  showDescription?: boolean;
  class?: string;
  rest?: any; // catch-all for any additional parameters, such as "aria-label"
}

const { post, showDescription = false, class: className, ...rest } = Astro.props as Props;
const { title, description, pubDate, heroImage, categories } = post.data;
const category = categories?.find((c): c is string => typeof c === "string");

const currLocale = getLocaleFromUrl(Astro.url);
---

<article
  class:list={[
    "card-tint card-tint-hover rounded-r15 group grid overflow-hidden transition-colors md:grid-cols-5",
    className,
  ]}
  {...rest}
  data-pagefind-ignore
>
  <a
    href={`/blog/${post.id}`}
    class="stroke-tint block aspect-video overflow-hidden border-b md:col-span-3 md:aspect-auto md:border-r md:border-b-0"
  >
    <Image
      src={heroImage}
      alt={`${title} blog post`}
      width={960}
      height={540}
      densities={[1, 2]}
      quality={90}
      class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
    />
  </a>
  <div class="flex flex-col gap-5 p-6 md:col-span-2 md:p-8">
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <time class="subtitle-pixel text-muted-foreground" datetime={pubDate.toISOString()}>
        {formatDate(pubDate, currLocale)}
      </time>
      {category && <span class="subtitle-pixel text-accent-text">{category}</span>}
    </div>
    <a
      href={`/blog/${post.id}`}
      class="text-foreground hover:text-primary-500 no-underline transition-colors"
    >
      <h2 class="h3 line-clamp-4">{title}</h2>
    </a>
    {showDescription && (
      <p class="text-muted-foreground line-clamp-4 text-base leading-[1.5]">{description}</p>
    )}
  </div>
</article>
