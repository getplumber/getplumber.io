---
/**
 * Featured post at the top of the blog list (Figma Blog-Black, frame 1000001573, 1320 x 494,
 * re-measured for the review of 2026-11-25): the hero image on the left (872 x 494) and a
 * 448px text column on the right with 32px of padding on every side (384px of text), laid
 * out top to bottom with 24px gaps:
 * - the tag row: category (20px pixel label at 60% line height after a 6px marker, no box
 *   around it since the review of 2026-11-27, like the other eyebrows) and the pixel
 *   month/year in the foreground white, closed by a #8D9596 25% rule 24px under them;
 * - the title (Inter Regular 32/110) and the lead (16/150, six lines at most) 32px apart;
 * - the "Learn more" link 32px under the lead (14px, accent, pixel chevron, underline 10px
 *   under text + chevron on hover, see .link-arrow in global.css).
 * Below lg the text column sits under the image.
 */
import { getLocaleFromUrl } from "@js/localeUtils";
import { Image } from "astro:assets";
import { type CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";

interface Props {
  post: CollectionEntry<"blog">;
  class?: string;
}

const { post, class: className } = Astro.props as Props;
const { title, description, pubDate, heroImage, categories } = post.data;
const category = categories?.find((c): c is string => typeof c === "string");

const currLocale = getLocaleFromUrl(Astro.url);
const monthYear = new Date(pubDate).toLocaleDateString(currLocale === "en" ? "en-US" : currLocale, {
  timeZone: "UTC",
  year: "numeric",
  month: "short",
});
---

<article
  class:list={[
    "post-featured group grid gap-6 lg:grid-cols-[minmax(0,872fr)_minmax(0,448fr)] lg:gap-0",
    className,
  ]}
  data-pagefind-ignore
>
  <a href={`/blog/${post.id}`} class="block overflow-hidden" aria-label={title} tabindex="-1">
    <Image
      src={heroImage}
      alt={`${title} blog post`}
      width={1744}
      height={988}
      densities={[1, 2]}
      quality={90}
      class="aspect-[872/494] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
      loading="eager"
    />
  </a>
  <div class="flex flex-col gap-6 lg:p-8">
    <div class="stroke-muted flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b pb-6">
      {category && (
        <span class="pixel-label-sm text-muted-foreground inline-flex items-center gap-2.5">
          <span class="post-featured__marker" aria-hidden="true"></span>
          {category}
        </span>
      )}
      <time class="pixel-label-sm text-foreground" datetime={pubDate.toISOString()}>
        {monthYear}
      </time>
    </div>
    <div class="flex flex-col gap-8">
      <div class="flex flex-col gap-8">
        <a
          href={`/blog/${post.id}`}
          class="text-foreground hover:text-primary-500 no-underline transition-colors"
        >
          <h2 class="post-featured__title font-heading font-normal">{title}</h2>
        </a>
        <p class="text-muted-foreground line-clamp-6 text-base leading-[1.5] font-normal">
          {description}
        </p>
      </div>
      <a href={`/blog/${post.id}`} class="link-arrow body-sm self-start">
        <span>Learn more</span>
        <Icon name="pixel/chevron" aria-hidden="true" />
      </a>
    </div>
  </div>
</article>

<style is:global>
  /* Figma H3: 32px at 110% (the shared .h3 only reaches 32px past 1600px wide) */
  .post-featured__title {
    font-size: clamp(1.5rem, 1.3rem + 0.7vw, 2rem);
    line-height: 1.1;
    line-height: round(1.1em, 1px);
  }
  @media (min-width: 1024px) {
    .post-featured__title {
      font-size: 2rem;
    }
  }
  .post-featured__marker {
    display: inline-block;
    width: 6px;
    height: 6px;
    flex: none;
    background-color: currentColor;
  }
</style>
