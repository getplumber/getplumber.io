---
/**
 * Scroll motion shared by the home and About us pages: drop it once in a page. The styles
 * (data-reveal, data-reveal-stagger, is-in-view) live in global.css.
 */
---

<script>
  /**
   * Reveal sections as they scroll into view (home review of 2026-10-27, used by the home
   * and About us pages). Elements with
   * data-reveal fade in as a block; the children of a data-reveal-stagger element fade in
   * one after the other through the --i custom property. The html class gates the hidden
   * state so nothing stays invisible without JavaScript. Elements with data-hover-reveal
   * carry the is-in-view class while they are in the viewport: on tablets and phones the
   * components play their hover states from it (the attribute value is the threshold).
   * Numbers marked data-count-up count from 0 to their value (kept in the HTML, with its
   * thousands separator and suffix, e.g. "120.000+") as their block fades in.
   */
  const observers: IntersectionObserver[] = [];
  const COUNT_DURATION = 1600;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  /** "120.000+" -> prefix "", value 120000, separator ".", suffix "+" */
  function parseCount(text: string) {
    const match = text.trim().match(/^(\D*)(\d{1,3}(?:([.,\s])\d{3})*|\d+)(\D*)$/);
    if (!match) return null;
    const [, prefix, digits, separator = "", suffix] = match;
    return { prefix, value: Number(digits.replace(/\D/g, "")), separator, suffix };
  }

  function formatCount(value: number, separator: string) {
    const digits = String(value);
    return separator ? digits.replace(/\B(?=(\d{3})+(?!\d))/g, separator) : digits;
  }

  /** Set the numbers inside a block to 0 now and count them up once it reveals. */
  function prepareCounts(block: Element) {
    if (reducedMotion.matches) return [];
    return Array.from(block.querySelectorAll<HTMLElement>("[data-count-up]")).flatMap((el) => {
      const parsed = parseCount(el.textContent ?? "");
      if (!parsed) return [];
      const final = el.textContent ?? "";
      el.textContent = `${parsed.prefix}0${parsed.suffix}`;
      // the element whose fade the count follows: its staggered child, or the block itself
      const fading = el.closest("[data-reveal-stagger] > *") ?? block;
      return [{ el, final, fading, ...parsed }];
    });
  }

  /** Count once the block is visible, starting with the fade (its transition-delay). */
  function runCounts(counts: ReturnType<typeof prepareCounts>) {
    counts.forEach(({ el, final, fading, prefix, value, separator, suffix }) => {
      const delay = parseFloat(getComputedStyle(fading).transitionDelay) * 1000 || 0;
      let start = 0;
      const frame = (now: number) => {
        start ||= now;
        const t = Math.min(1, (now - start) / COUNT_DURATION);
        if (t >= 1) {
          el.textContent = final;
          return;
        }
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = `${prefix}${formatCount(Math.round(value * eased), separator)}${suffix}`;
        requestAnimationFrame(frame);
      };
      window.setTimeout(() => requestAnimationFrame(frame), delay);
    });
  }

  function initReveal() {
    // observers of the previous page (view transitions) stop here
    observers.splice(0).forEach((old) => old.disconnect());
    const targets = document.querySelectorAll<HTMLElement>("[data-reveal], [data-reveal-stagger]");
    const hoverTargets = document.querySelectorAll<HTMLElement>("[data-hover-reveal]");
    if (!targets.length && !hoverTargets.length) return;
    document.documentElement.classList.add("reveal-ready");
    const counts = new Map<Element, ReturnType<typeof prepareCounts>>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
          runCounts(counts.get(entry.target) ?? []);
        });
      },
      { rootMargin: "0px 0px -12% 0px", threshold: 0.05 },
    );
    observers.push(observer);
    targets.forEach((target) => {
      if (target.hasAttribute("data-reveal-stagger")) {
        Array.from(target.children).forEach((child, i) => {
          (child as HTMLElement).style.setProperty("--i", String(i));
        });
      }
      counts.set(target, prepareCounts(target));
      observer.observe(target);
    });

    const byThreshold = new Map<number, IntersectionObserver>();
    hoverTargets.forEach((target) => {
      const given = parseFloat(target.dataset.hoverReveal || "");
      const threshold = Number.isFinite(given) ? Math.min(1, Math.max(0, given)) : 0.5;
      let hoverObserver = byThreshold.get(threshold);
      if (!hoverObserver) {
        hoverObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              entry.target.classList.toggle("is-in-view", entry.isIntersecting);
            });
          },
          { rootMargin: "-10% 0px -10% 0px", threshold },
        );
        byThreshold.set(threshold, hoverObserver);
        observers.push(hoverObserver);
      }
      hoverObserver.observe(target);
    });
  }

  initReveal();
  document.addEventListener("astro:after-swap", initReveal);
</script>
