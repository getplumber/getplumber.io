---
import { Icon } from "astro-icon/components";

interface Props {
  variant: "tip" | "caution" | "danger" | "info";
  title?: string;
}

const { variant, title } = Astro.props as Props;

// create a switch statement that switches on "variant" and returns the appropriate icon
const icon = (() => {
  switch (variant) {
    case "tip":
      return "tabler/bulb";
    case "caution":
      return "tabler/alert-triangle";
    case "danger":
      return "tabler/flame";
    case "info":
      return "tabler/info-circle";
  }
})();

if (!icon) {
  throw new Error(`Invalid variant: ${variant}. Icon not found.`);
}
---

<div
  class:list={[
    "docs-aside text-foreground rounded-r8 my-6 border px-6 py-4",

    {
      "border-accent-20 bg-primary-500/5 docs-aside-success": variant === "tip",
    },
    {
      "border-warning/40 bg-warning/5 docs-aside-warning": variant === "caution",
    },
    {
      "border-danger-25 bg-danger-5 docs-aside-error": variant === "danger",
    },
    {
      "border-accent-20 bg-primary-500/5 docs-aside-info": variant === "info",
    },
  ]}
>
  <div class="not-content flex items-center gap-3 pb-2">
    <Icon
      name={icon}
      class:list={[
        "size-[22px] shrink-0",
        {
          "text-primary-500": variant === "tip",
        },
        {
          "text-warning": variant === "caution",
        },
        {
          "text-danger-500": variant === "danger",
        },
        {
          "text-primary-500": variant === "info",
        },
      ]}
    />
    <p class="subtitle text-foreground">
      {title || variant.charAt(0).toUpperCase() + variant.slice(1)}
    </p>
  </div>
  <slot />
</div>

<style is:global>
  @import "tailwindcss/theme" theme(reference);
  @import "@/styles/tailwind-theme.css" theme(reference);

  .docs-aside > :first-child {
    @apply mt-0;
  }
  .docs-aside > :nth-child(2) {
    @apply mt-0;
  }
  .docs-aside > :last-child {
    @apply mb-0;
  }
  .docs-aside code {
    background-color: var(--color-tint-10);
    border-color: var(--color-tint-25);
  }
</style>
