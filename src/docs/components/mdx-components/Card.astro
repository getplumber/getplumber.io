---
/**
 * Docs card (Figma Docs_Getting-Started_OK, re-measured on 2026-11-18): a bordered card with
 * 8px corners and the #5C6262 5% fill over its whole height (review of 2026-11-27), 218px
 * tall when it has no icon (the "Go further" cards), a 71px header (24px padding; a 16/140 Medium title, or a 16px icon and a 14/140 title for the provider
 * cards; an optional pixel env chip on the right), then a 24px-padded body with the 14/140
 * grey text and, 32px lower, the chevron links (14px, accent, 8 x 14.4 pixel chevron 8px
 * after the label, 24px apart, underlined 10px under text + chevron on hover like every
 * .link-arrow). The "link" variant ("Community & support") is one clickable row: a 24px
 * icon in a 46px column, centred on the eyebrow and title, 16px, a 20px pixel eyebrow
 * and the 16/150 title on two 22px lines, the 14.86 x 26 pixel chevron on the right, 24px
 * padding (stroke inside) and 8px outer corners; on hover the card turns accent blue, text
 * near-black and the title Medium.
 */
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  /** astro-icon name shown before the title, e.g. "tabler/brand-github" */
  icon?: string;
  /** monospace chip shown at the right of the header, e.g. an env var name */
  badge?: string;
  /** chevron links rendered under the body */
  links?: { text: string; href: string }[];
  /** "link": the whole card is one anchor with eyebrow + title */
  variant?: "default" | "link";
  eyebrow?: string;
  href?: string;
  class?: string;
}

const {
  title,
  icon,
  badge,
  links = [],
  variant = "default",
  eyebrow,
  href,
  class: className,
} = Astro.props;
---

{variant === "link" ? (
  <a
    href={href}
    class:list={[
      "docs-card docs-card--link not-content stroke-tint bg-tint-5 flex items-center gap-4 border p-[23px] no-underline transition-colors duration-150",
      className,
    ]}
  >
    {icon && (
      <span class="flex w-[46px] shrink-0" aria-hidden="true">
        <Icon name={icon} class="docs-card__icon text-primary-500 -ml-px size-6" />
      </span>
    )}
    <span class="flex min-w-0 flex-1 flex-col gap-0.5">
      {eyebrow && (
        <span class="flex h-[22px] items-center">
          <span class="docs-card__eyebrow pixel-label-sm text-muted-foreground">{eyebrow}</span>
        </span>
      )}
      <span class="flex h-[22px] items-center">
        <span class="docs-card__title text-foreground text-base leading-6 [overflow-wrap:anywhere]">
          {title}
        </span>
      </span>
    </span>
    <Icon
      name="pixel/chevron-lg"
      class="docs-card__chevron chevron-lg text-primary-500"
      aria-hidden="true"
    />
  </a>
) : (
  <div
    class:list={[
      "docs-card not-content stroke-tint bg-tint-5 flex flex-col overflow-hidden rounded-[8px] border",
      !icon && "md:min-h-[218px]",
      className,
    ]}
  >
    <div class="stroke-tint flex min-h-[71px] items-center justify-between gap-6 border-b p-6">
      <span
        class:list={[
          "text-foreground flex items-center gap-2",
          icon ? "text-sm leading-5 font-normal" : "text-base leading-[22px] font-medium",
        ]}
      >
        {icon && <Icon name={icon} class="size-4 shrink-0" aria-hidden="true" />}
        <span class="link-trim">{title}</span>
      </span>
      {badge && <code class="docs-card__badge">{badge}</code>}
    </div>
    <div class="docs-card__body text-muted-foreground flex flex-1 flex-col gap-8 p-6 text-sm leading-5">
      <div class="docs-card__content">
        <slot />
      </div>
      {links.length > 0 && (
        <div class="mt-auto flex flex-wrap gap-6">
          {links.map((link) => (
            <a href={link.href} class="link-arrow text-sm">
              <span>{link.text}</span>
              <Icon name="pixel/chevron" aria-hidden="true" />
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
)}

<style is:global>
  /* Figma env chip (Frame 38898): 22px tall, #8D9596 at 5% with a 25% stroke, 4px radius,
     the 18px pixel label in grey */
  .docs-card__badge {
    flex: none;
    padding: 3px 7px;
    border: 1px solid color-mix(in srgb, var(--color-base-400) 25%, transparent);
    border-radius: 4px;
    background-color: color-mix(in srgb, var(--color-base-400) 5%, transparent);
    color: var(--color-base-400);
    font-family: var(--font-pixel);
    font-size: 1.125rem;
    line-height: 14px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .docs-card__content > :first-child {
    margin-top: 0;
  }
  .docs-card__content > :last-child {
    margin-bottom: 0;
  }
  /* Figma trims the 14/140 text boxes to cap height and baseline: 5px off each side of a
     20px line, so the 24px gaps and paddings land on the letters as in the file */
  .docs-card .docs-card__content p,
  .docs-card .docs-card__content li {
    margin-block: -5px;
  }
  /* square bullets inside cards (Figma GitHub card): 14/140 grey items 24px apart, a 6px
     square 8px before the text at its cap height, accent for the first item, grey after */
  .docs-card__content ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .docs-card__content ul > li {
    position: relative;
    margin: 0;
    padding-left: 14px;
    color: var(--color-base-400);
  }
  .docs-card__content ul > li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 5px;
    width: 6px;
    height: 6px;
    background-color: var(--color-base-400);
  }
  .docs-card__content ul > li:first-child::before {
    background-color: var(--color-primary-500);
  }
  .docs-card__content code {
    color: var(--foreground);
  }
  /* link cards sit edge to edge inside a CardGrid */
  .docs-card--link:first-child {
    border-radius: 8px 0 0 8px;
  }
  .docs-card--link:last-child {
    border-radius: 0 8px 8px 0;
  }
  @media (max-width: 767px) {
    .docs-card--link {
      border-radius: 8px !important;
    }
  }
  /* the Figma hover: accent fill, near-black text and icons */
  .docs-card--link:hover,
  .docs-card--link:focus-visible {
    background-color: var(--color-primary-500);
    border-color: var(--color-primary-500);
  }
  .docs-card--link:hover .docs-card__icon,
  .docs-card--link:hover .docs-card__chevron,
  .docs-card--link:hover .docs-card__title,
  .docs-card--link:focus-visible .docs-card__icon,
  .docs-card--link:focus-visible .docs-card__chevron,
  .docs-card--link:focus-visible .docs-card__title {
    color: var(--color-base-950);
  }
  .docs-card--link:hover .docs-card__title,
  .docs-card--link:focus-visible .docs-card__title {
    font-weight: 500;
  }
  .docs-card--link:hover .docs-card__eyebrow,
  .docs-card--link:focus-visible .docs-card__eyebrow {
    color: #161818;
  }
  .docs-card svg {
    shape-rendering: crispEdges;
  }
</style>
