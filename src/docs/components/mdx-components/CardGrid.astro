---
/**
 * Two-column grid for docs Cards (Figma "Go further" and "Community & support" blocks).
 * "joined" removes the gap so link cards form one strip.
 */
interface Props {
  joined?: boolean;
  class?: string;
}

const { joined = false, class: className } = Astro.props;
---

<div
  class:list={[
    "not-content my-8 grid md:grid-cols-2",
    joined ? "gap-0 md:[&>*+*]:border-l-0" : "gap-6",
    className,
  ]}
>
  <slot />
</div>
