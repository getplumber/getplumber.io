---
/**
 * Docs page footer row (Figma node 2556:6048): "Last updated" on the left when the page
 * declares a date, the previous page link under it, and the "next page" block on the right.
 */
import { Icon } from "astro-icon/components";

import { docsRoute } from "@/docs/js/docsUtils";

interface PageRef {
  slug: string;
  title: string;
}

interface Props {
  prev: PageRef | null;
  next: PageRef | null;
  lastUpdated?: Date;
}

const { prev, next, lastUpdated } = Astro.props;

const formatted = lastUpdated
  ? lastUpdated.toLocaleDateString("en-US", { month: "short", year: "numeric" })
  : null;
---

<nav
  class="stroke-tint mt-16 flex flex-wrap items-start justify-between gap-8 border-t pt-10"
  aria-label="Page navigation"
>
  <div class="flex flex-col gap-6">
    {formatted && (
      <p class="body-sm text-muted-foreground flex items-center gap-2.5">
        <span>Last updated</span>
        <span class="bg-base-400 size-0.5" aria-hidden="true" />
        <time datetime={lastUpdated?.toISOString()}>{formatted}</time>
      </p>
    )}
    {prev && (
      <a href={`/${docsRoute}/${prev.slug}`} class="group flex flex-col gap-4">
        <span class="subtitle-pixel text-muted-foreground">previous page</span>
        <span class="docs-pager__link link-arrow link-arrow--plain body-sm">
          <Icon name="home/pixel-chevron" class="rotate-180" aria-hidden="true" />
          <span>{prev.title}</span>
        </span>
      </a>
    )}
  </div>
  {next && (
    <a href={`/${docsRoute}/${next.slug}`} class="group ml-auto flex flex-col gap-4">
      <span class="subtitle-pixel text-muted-foreground">next page</span>
      <span class="docs-pager__link link-arrow link-arrow--plain body-sm">
        <span>{next.title}</span>
        <Icon name="home/pixel-chevron" aria-hidden="true" />
      </span>
    </a>
  )}
</nav>

<style>
  /* Figma page link: 14/140 in #C6C6C6 (accent on hover), the 6 x 10.8 pixel chevron 8px
     from the label, 16px under the 18px pixel "next page" label */
  .docs-pager__link {
    color: var(--color-base-200);
    transition: color 150ms ease;
  }
  .group:hover .docs-pager__link,
  .group:focus-visible .docs-pager__link {
    color: var(--accent-text);
  }
</style>
