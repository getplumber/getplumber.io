---
/**
 * Sidebar menu row (Figma Component_Menu-Smaller): 42px row with a 6px square marker
 * that lights up teal on the current page, a tint background on hover and current.
 * Indented rows (Figma Component 134) hang from a tint stroke instead.
 */
import type { ComponentProps } from "astro/types";
import { Icon } from "astro-icon/components";

import Badge from "@/docs/components/mdx-components/Badge.astro";

/**
 * Compares two paths ensuring they both have trailing slashes for consistency
 */
const comparePathsWithTrailingSlash = (path1: string, path2: string): boolean => {
  const ensureTrailingSlash = (path: string): string => (path.endsWith("/") ? path : `${path}/`);

  return ensureTrailingSlash(path1) === ensureTrailingSlash(path2);
};

interface Props {
  link: string;
  text: string;
  indent?: boolean;
  badge?: ComponentProps<typeof Badge>;
  /** Optional astro-icon name rendered before the label (e.g. `tabler/brand-github`). */
  icon?: string;
  /** When true, also active for paths under this link (e.g. issue detail pages under the Issues index). */
  highlightDescendants?: boolean;
}

const { link, text, indent = false, badge, icon, highlightDescendants = false } = Astro.props;

// internal link - normalize to remove trailing slash (except root)
const actualLink = link === "/" ? "/" : link.replace(/\/$/, "");

const pathname = Astro.url.pathname;
const linkWithSlash = actualLink.endsWith("/") ? actualLink : `${actualLink}/`;
const currentWithSlash = pathname.endsWith("/") ? pathname : `${pathname}/`;

const currentPath =
  highlightDescendants && actualLink !== "/"
    ? comparePathsWithTrailingSlash(pathname, actualLink) ||
      currentWithSlash.startsWith(linkWithSlash)
    : comparePathsWithTrailingSlash(pathname, actualLink);
---

<li class:list={[indent && "sidebar-link--indent"]}>
  <a
    href={actualLink}
    class:list={["sidebar-link docs-primary-focus", { "sidebar-link--current": currentPath }]}
    aria-current={currentPath ? "page" : undefined}
  >
    <span class="sidebar-link__marker" aria-hidden="true"></span>
    {icon && <Icon name={icon} class="size-4 shrink-0" aria-hidden="true" />}
    <span class="min-w-0 flex-1">{text}</span>
    {badge && <Badge text={badge.text} variant={badge.variant} />}
  </a>
</li>

<style>
  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-radius: 10px;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--muted-foreground);
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }
  .sidebar-link:hover,
  .sidebar-link--current {
    background-color: var(--color-tint-25);
    color: var(--foreground);
  }
  .sidebar-link__marker {
    width: 6px;
    height: 6px;
    flex: none;
    background-color: transparent;
  }
  .sidebar-link--current .sidebar-link__marker {
    background-color: var(--color-primary-500);
  }

  /* nested rows hang from a tint stroke (Figma Component 134) */
  .sidebar-link--indent {
    padding-left: 2.25rem;
  }
  .sidebar-link--indent .sidebar-link {
    border-left: 1px solid var(--color-tint-25);
    border-radius: 0;
    padding: 0.5rem 1rem;
  }
  .sidebar-link--indent .sidebar-link__marker {
    display: none;
  }
  .sidebar-link--indent .sidebar-link:hover,
  .sidebar-link--indent .sidebar-link--current {
    background-color: transparent;
  }
  .sidebar-link--indent .sidebar-link--current {
    border-left-color: var(--color-primary-500);
  }
</style>
