---
/**
 * * This is both the mobile and desktop nav
 */
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

import { siteSettings } from "@/docs/config/siteSettings.json";
import {
  docsRoute,
  getSectionById,
  getSectionTitle,
  getTabById,
  getTabSections,
  hrefToContentId,
  resolveSharedDocsHref,
} from "@/docs/js/docsUtils";
import { filterCollectionByLanguage } from "@/docs/js/localeUtils";
import { getLocaleFromUrl } from "@/docs/js/localeUtils";
import { getLocalizedRoute, getTranslatedData } from "@/docs/js/translationUtils";

import SidebarLink from "./SidebarLink.astro";

/** Issues is documented as nested under Controls; keep indent even if frontmatter is missing or coerced wrong. */
function isIndentedUsePlumberChild(section: string, docId: string): boolean {
  if (section !== "use-plumber") return false;
  const rest = docId.slice(section.length + 1);
  const normalized = rest.replace(/\/index$/, "");
  return normalized === "issues";
}

function resolveSidebarIndent(doc: {
  id: string;
  data: { sidebar?: { indent?: boolean | string } };
}, section: string): boolean {
  const raw = doc.data.sidebar?.indent;
  if (raw === true || raw === "true") return true;
  return isIndentedUsePlumberChild(section, doc.id);
}

function normalizeContentId(contentId: string): string {
  return contentId.replace(/\/index$/, "");
}

/** Open Source CLI pages: installation, then providers (GitHub before GitLab), then the reference (overrides title sort). */
const CLI_PROVIDER_SIDEBAR_RANK: Record<string, number> = {
  "cli/installation": 2,
  "cli/github": 3,
  "cli/gitlab": 4,
  "cli/reference": 5,
};

function sidebarSortRank(item: { contentId: string; order?: number }): number {
  const id = normalizeContentId(item.contentId);
  if (id in CLI_PROVIDER_SIDEBAR_RANK) return CLI_PROVIDER_SIDEBAR_RANK[id];
  if (item.order !== undefined) return item.order;
  return 10_000;
}

function compareSidebarItems(
  a: { contentId: string; order?: number; text: string },
  b: { contentId: string; order?: number; text: string },
  locale: string,
): number {
  const diff = sidebarSortRank(a) - sidebarSortRank(b);
  if (diff !== 0) return diff;
  return a.text.localeCompare(b.text, locale, {
    sensitivity: "base",
    numeric: true,
  });
}

interface Props {
  sectionId?: string;
}

const { sectionId = "main" } = Astro.props;
const currLocale = getLocaleFromUrl(Astro.url);
const sidebarData = getTranslatedData("sidebarNavData", currLocale);

// Get localized documentation tabs based on current locale
const sidebarTabs = sidebarData.tabs;
// Get the current tab configuration
const currentTab = getTabById(sectionId, currLocale);
// Get sections for the current tab
const currentTabSections = currentTab?.sections || [];

// Get all non-draft docs
const allDocs = await getCollection("docs", ({ data }) => {
  return data.draft !== true;
});

// Map to store the first page URL for each section
const firstPagesMap = new Map();

// get rid of pages from other languages and remove locale from slug
const filteredDocs = filterCollectionByLanguage(allDocs, currLocale);

// Filter docs by their section - match docs to the current tab based on folder structure
// If tabs are configured, find which sections belong to the current tab and filter docs accordingly
let sectionFilteredDocs: typeof filteredDocs;

if (sidebarTabs && sidebarTabs.length > 0) {
  // Get the current tab configuration
  const currentTab = getTabById(sectionId, currLocale);
  const currentTabSections = currentTab?.sections || [];

  if (currentTabSections.length > 0) {
    // Get all section IDs for the current tab
    const sectionIds = new Set(currentTabSections.map((s) => s.id));

    // Filter docs where the first segment of doc.id matches one of the tab's sections
    sectionFilteredDocs = filteredDocs.filter((doc) => {
      const firstSegment = doc.id.split("/")[0];
      return sectionIds.has(firstSegment);
    });
  } else {
    // If no sections configured for this tab, show all docs (fallback)
    sectionFilteredDocs = filteredDocs;
  }
} else {
  // If no tabs configured, show all docs
  sectionFilteredDocs = filteredDocs;
}

// Find the first page for each tab based on its ordered sections
if (sidebarTabs) {
  // For each tab (documentation section)
  for (const tab of sidebarTabs) {
    // Get sections for this tab
    const tabSections = getTabSections(tab.id, currLocale);
    const tabSectionIds = tabSections ? new Set(tabSections.map((s) => s.id)) : new Set();

    // Get all docs for this tab - match by folder structure (first segment of doc.id)
    const tabDocs = filteredDocs.filter((doc) => {
      const firstSegment = doc.id.split("/")[0];
      return tabSectionIds.has(firstSegment);
    });

    // Get the sections for this tab in their configured order

    // If we have configured sections and docs
    if (tabSections && tabSections.length > 0 && tabDocs.length > 0) {
      let firstPageFound = false;

      // For each section in the config order
      for (const section of tabSections) {
        // Find docs in this section (top-level directory) and index file
        const sectionDocs = tabDocs.filter((doc) => doc.id.startsWith(section.id + "/"));

        // Find index files in this section (doc.id == section.id, like 'getting-started/index')
        const indexDoc = tabDocs.find(
          (doc) => doc.id === section.id || doc.id === `${section.id}/index`,
        );

        // If we have an index doc, use that as the first page
        if (indexDoc) {
          const firstPageUrl = `/${docsRoute}/${indexDoc.id}`;
          firstPagesMap.set(tab.id, firstPageUrl);
          firstPageFound = true;
          break; // Exit loop once we've found the first page
        }
        // If we have other docs in this section
        else if (sectionDocs.length > 0) {
          // Sort the docs within this section
          const sortedSectionDocs = [...sectionDocs].sort((a, b) => {
            // If both have order, sort by order
            if (a.data.sidebar?.order !== undefined && b.data.sidebar?.order !== undefined) {
              return a.data.sidebar.order - b.data.sidebar.order;
            }

            // If only one has order, it comes first
            if (a.data.sidebar?.order !== undefined) return -1;
            if (b.data.sidebar?.order !== undefined) return 1;

            // If neither has order, sort by title
            return a.data.title.localeCompare(b.data.title);
          });

          // Use the first doc from the first section that has docs
          const firstPageUrl = `/${docsRoute}/${sortedSectionDocs[0].id}`;
          firstPagesMap.set(tab.id, firstPageUrl);
          firstPageFound = true;
          break; // Exit loop once we've found the first page
        }
      }

      // If no docs found in any section, fall back to generic approach
      if (!firstPageFound) {
        // Sort all tab docs as a fallback
        const sortedDocs = [...tabDocs].sort((a, b) => {
          // If both have order, sort by order
          if (a.data.sidebar?.order !== undefined && b.data.sidebar?.order !== undefined) {
            return a.data.sidebar.order - b.data.sidebar.order;
          }

          // If only one has order, it comes first
          if (a.data.sidebar?.order !== undefined) return -1;
          if (b.data.sidebar?.order !== undefined) return 1;

          // If neither has order, sort by title
          return a.data.title.localeCompare(b.data.title);
        });

        if (sortedDocs.length > 0) {
          const firstPageUrl = `/${docsRoute}/${sortedDocs[0].id}`;
          firstPagesMap.set(tab.id, firstPageUrl);
        } else {
          // Fallback to section base route if no docs
          firstPagesMap.set(tab.id, `/${docsRoute}`);
        }
      }
    } else if (tabDocs.length > 0) {
      // No sections configured but we have docs
      // Use standard sorting logic as fallback
      const sortedDocs = [...tabDocs].sort((a, b) => {
        // If both have order, sort by order
        if (a.data.sidebar?.order !== undefined && b.data.sidebar?.order !== undefined) {
          return a.data.sidebar.order - b.data.sidebar.order;
        }

        // If only one has order, it comes first
        if (a.data.sidebar?.order !== undefined) return -1;
        if (b.data.sidebar?.order !== undefined) return 1;

        // If neither has order, sort by title
        return a.data.title.localeCompare(b.data.title);
      });

      const firstPageUrl = `/${docsRoute}/${sortedDocs[0].id}`;
      firstPagesMap.set(tab.id, firstPageUrl);
    } else {
      // No docs and no sections or empty sections
      firstPagesMap.set(tab.id, `/${docsRoute}`);
    }
  }
}

// Group docs by their top-level directory
// Skip docs hidden from the sidebar nav (they still build; used for pages aliased into another tab)
const docsBySection = sectionFilteredDocs
  .filter((doc) => doc.data.sidebar?.hidden !== true)
  .reduce(
    (acc, doc) => {
      // Get the top-level directory from the doc.id
      const [section] = doc.id.split("/");
      if (!acc[section]) {
        acc[section] = [];
      }

      acc[section].push({
        contentId: doc.id,
        text: doc.data.sidebar?.label ? doc.data.sidebar.label : doc.data.title,
        link: `/${docsRoute}/${doc.id}`,
        order: doc.data.sidebar?.order,
        grouped: doc.data.sidebar?.grouped,
        indent: resolveSidebarIndent(doc, section),
        badge: doc.data.sidebar?.badge,
        icon: doc.data.sidebar?.icon,
      });
      return acc;
    },
    {} as Record<
      string,
      Array<{
        contentId: string;
        text: string;
        link: string;
        order?: number;
        grouped?: boolean;
        indent?: boolean;
        label?: string;
        badge?: { text: string; variant: "tip" | "caution" | "danger" | "info" };
        icon?: string;
      }>
    >,
  );

// Get ordered section IDs from the current tab sections and create a Map for faster lookups
const orderedSectionIds = currentTabSections.map((section) => section.id);
const sectionIndexMap = new Map(orderedSectionIds.map((id, index) => [id, index]));

// Sort sections according to the config order
const sections = Object.keys(docsBySection).sort((a, b) => {
  const aIndex = sectionIndexMap.get(a) ?? -1;
  const bIndex = sectionIndexMap.get(b) ?? -1;

  // If neither section is in the config, sort by translated titles
  if (aIndex === -1 && bIndex === -1) {
    return getSectionTitle(a, sectionId, currLocale).localeCompare(
      getSectionTitle(b, sectionId, currLocale),
      currLocale,
    );
  }

  // Prioritize configured sections over unconfigured ones
  return aIndex === -1 ? 1 : bIndex === -1 ? -1 : aIndex - bIndex;
});

// Sort docs within each section
for (const section of sections) {
  docsBySection[section].sort((a, b) => compareSidebarItems(a, b, currLocale));
}

// Consecutive sections sharing a `group` render nested under one bold group
// heading (e.g. Platform > Installation / Usage); others render standalone
type SidebarRenderEntry = { group?: string; ids: string[] };
const renderEntries: SidebarRenderEntry[] = [];
for (const id of sections) {
  const group = getSectionById(id, sectionId, currLocale)?.group;
  const last = renderEntries[renderEntries.length - 1];
  if (group && last?.group === group) {
    last.ids.push(id);
  } else {
    renderEntries.push({ group, ids: [id] });
  }
}
---

<nav class="space-y-8">
  <slot name="before-links" />

  {/* Documentation Tabs Selector */}
  {
    sidebarTabs && sidebarTabs.length > 1 && (
      <div class="mb-6">
        <nav aria-label="Documentation Sections" class="bg-muted/30 mr-4 rounded-md border p-2">
          <ul class="space-y-1">
            {sidebarTabs.map((section) => {
              // Get the current URL path and determine if this section is active
              const isActive = section.id === sectionId;

              return (
                <li>
                  <a
                    href={firstPagesMap.get(section.id)}
                    class:list={[
                      "flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm font-medium transition-colors",
                      isActive
                        ? "bg-muted text-foreground"
                        : "text-muted-foreground hover:bg-muted hover:text-foreground",
                    ]}
                    aria-current={isActive ? "page" : undefined}
                  >
                    {section.icon && (
                      <Icon name={section.icon} class="size-4 shrink-0" aria-hidden="true" />
                    )}
                    <span class="flex-1">{section.title}</span>
                    {section.description && <span class="sr-only">: {section.description}</span>}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      </div>
    )
  }

  {/* Section Content */}
  <div id={`${sectionId}-content`} role="tabpanel">
    {
      renderEntries.map((entry) => {
        if (entry.group) {
          return (
            <div class="mb-8">
              <h2 class="mb-2 text-lg font-semibold md:text-base">{entry.group}</h2>
              <div class="border-border ml-0.5 space-y-5 border-l pl-3">
                {entry.ids.map((section) => {
                  // Pages marked grouped:false lift out of the section's sub-list
                  // and render as direct links at the group level, placed before
                  // or after the sub-list according to their sidebar order
                  const all = docsBySection[section];
                  const inner = all.filter((d) => d.grouped !== false);
                  const minInner = Math.min(...inner.map((d) => d.order ?? Infinity));
                  const pre = all.filter(
                    (d) => d.grouped === false && (d.order ?? Infinity) < minInner,
                  );
                  const post = all.filter(
                    (d) => d.grouped === false && (d.order ?? Infinity) >= minInner,
                  );
                  const renderLifted = (docs: typeof all) => (
                    <ul class="space-y-2">
                      {docs.map((doc) => (
                        <SidebarLink
                          link={doc.link}
                          text={doc.text}
                          badge={doc.badge}
                          icon={doc.icon}
                          highlightDescendants={doc.contentId === "use-plumber/issues"}
                        />
                      ))}
                    </ul>
                  );
                  return (
                    <div class="space-y-5">
                      {pre.length > 0 && renderLifted(pre)}
                      {inner.length > 0 && (
                        <div>
                          <h3 class="text-foreground mb-2 text-base font-medium md:text-sm">
                            {getSectionTitle(section, sectionId, currLocale)}
                          </h3>
                          <ul class="border-border ml-0.5 space-y-2 border-l pl-3">
                            {inner.map((doc) => (
                              <SidebarLink
                                link={doc.link}
                                text={doc.text}
                                indent={doc.indent}
                                badge={doc.badge}
                                icon={doc.icon}
                                highlightDescendants={doc.contentId === "use-plumber/issues"}
                              />
                            ))}
                          </ul>
                        </div>
                      )}
                      {post.length > 0 && renderLifted(post)}
                    </div>
                  );
                })}
              </div>
            </div>
          );
        }

        const section = entry.ids[0];
        const sectionNavLinks = getSectionById(section, sectionId, currLocale)?.navLinks ?? [];
        // A section with a single page and no extra links collapses to one
        // link line labeled with the section title (no heading + duplicate)
        if (docsBySection[section].length === 1 && sectionNavLinks.length === 0) {
          const doc = docsBySection[section][0];
          return (
            <div class="mb-8">
              <ul class="space-y-2">
                <SidebarLink
                  link={doc.link}
                  text={getSectionTitle(section, sectionId, currLocale)}
                  badge={doc.badge}
                  icon={doc.icon}
                  emphasis
                />
              </ul>
            </div>
          );
        }
        return (
        <div class="mb-8">
          <h2 class="mb-2 text-lg font-semibold md:text-base">
            {getSectionTitle(section, sectionId, currLocale)}
          </h2>
          <ul class="border-border ml-0.5 space-y-2 border-l pl-3">
            {docsBySection[section].map((doc) => (
              <SidebarLink
                link={doc.link}
                text={doc.text}
                indent={doc.indent}
                badge={doc.badge}
                icon={doc.icon}
                highlightDescendants={doc.contentId === "use-plumber/issues"}
              />
            ))}
            {sectionNavLinks.map((item) => {
              const link = getLocalizedRoute(
                currLocale,
                resolveSharedDocsHref(item.href, sectionId),
              );
              const issuesContentId = `${hrefToContentId(item.href)?.replace(/\/index$/, "")}`;
              const isIssuesNavLink = issuesContentId?.endsWith("/issues");

              return (
                <SidebarLink
                  link={link}
                  text={item.text}
                  indent={item.indent}
                  highlightDescendants={isIssuesNavLink}
                />
              );
            })}
          </ul>
        </div>
        );
      })
    }
  </div>

  <slot name="after-links" />
</nav>
