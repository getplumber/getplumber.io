---
/**
 * Docs layout for standalone pages (e.g. error code pages) that are not
 * from the content collection. Provides the same shell as DocsLayout
 * (sidebar with search, content column, on-this-page rail) without the
 * page header and pagination; the page renders its own heading.
 */
import type { MarkdownHeading } from "astro";

import type { BreadcrumbItem, FaqItem } from "@/js/jsonLD";

import BaseLayoutDocs from "./BaseLayoutDocs.astro";
import DocsShell from "./DocsShell.astro";

interface Props {
  title: string;
  description: string;
  sectionId?: string;
  headings?: MarkdownHeading[];
  minHeadingLevel?: number;
  maxHeadingLevel?: number;
  structuredData?: {
    headline?: string;
    breadcrumbs?: BreadcrumbItem[];
    faq?: FaqItem[];
  };
}

const {
  title,
  description,
  sectionId = "main",
  headings = [],
  minHeadingLevel = 2,
  maxHeadingLevel = 3,
  structuredData,
} = Astro.props;

const filteredHeadings = headings.filter(
  (h) => h.depth <= maxHeadingLevel && h.depth >= minHeadingLevel,
);
---

<BaseLayoutDocs
  title={title}
  description={description}
  sectionId={sectionId}
  structuredData={structuredData}
>
  <DocsShell sectionId={sectionId} headings={filteredHeadings} minHeadingLevel={minHeadingLevel}>
    <slot />
  </DocsShell>
</BaseLayoutDocs>
