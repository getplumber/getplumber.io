---
import Button from "@components/Button/Button.astro";
import PostCard from "@components/PostCard/PostCard.astro";
import TableOfContents from "@components/TableOfContents/TableOfContents.astro";
import { getAllPosts } from "@js/blogUtils";
import { getLocaleFromUrl } from "@js/localeUtils";
import { formatDate } from "@js/textUtils";
import { Image } from "astro:assets";
import { type CollectionEntry, getEntries } from "astro:content";

// main layout
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: CollectionEntry<"blog">;
  headings: import("astro").MarkdownHeading[];
}

const { post, headings } = Astro.props as Props;
const { title, description, authors, pubDate, updatedDate, heroImage } = post.data;

const currLocale = getLocaleFromUrl(Astro.url);
const authorsData = await getEntries(authors);
const authorNames = authorsData.map((author) => author.data.name).join(", ");

// Related posts: most shared categories first, newest first as tiebreaker
// (internal circulation between posts helps both readers and SEO)
const postCategories = post.data.categories?.filter(Boolean) ?? [];
const eyebrow = postCategories[0] ?? "Blog";
const allPosts = await getAllPosts(currLocale, true);
const relatedPosts = allPosts
  .filter((other) => other.id !== post.id)
  .map((other) => ({
    post: other,
    shared: (other.data.categories?.filter(Boolean) ?? []).filter((category) =>
      postCategories.includes(category),
    ).length,
  }))
  .filter(({ shared }) => shared > 0)
  .sort(
    (a, b) => b.shared - a.shared || b.post.data.pubDate.getTime() - a.post.data.pubDate.getTime(),
  )
  .slice(0, 3)
  .map(({ post: related }) => related);
---

<BaseLayout
  type="blog"
  title={title}
  description={description}
  heroImage={heroImage}
  authorsData={authorsData}
  postFrontmatter={post.data}
>
  <article class="site-container mt-24 mb-24 md:mt-36" data-pagefind-ignore>
    <!-- header: eyebrow (first category), pixel dates, uppercase title, lead, authors -->
    <header class="flex max-w-[786px] flex-col gap-6">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <p class="eyebrow flex items-center gap-2">
          <span class="bg-primary-500 block size-1.5" aria-hidden="true"></span>
          {eyebrow}
        </p>
        <time class="subtitle-pixel text-muted-foreground" datetime={pubDate.toISOString()}>
          {formatDate(pubDate, currLocale)}
        </time>
        {updatedDate && (
          <time class="subtitle-pixel text-muted-foreground" datetime={updatedDate.toISOString()}>
            Updated {formatDate(updatedDate, currLocale)}
          </time>
        )}
      </div>
      <!-- Title rendered here (not in post markdown) so every post has exactly one H1 -->
      <h1 class="h1 text-foreground uppercase">{title}</h1>
      <p class="body-lg text-muted-foreground">{description}</p>
      {authorNames && <p class="text-muted-foreground text-sm">By {authorNames}</p>}
    </header>

    <div class="mt-14 grid gap-12 lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-[60px]">
      <!-- main content -->
      <div class="min-w-0 max-w-[786px]">
        <!-- hero at top of page on mobile/tablet -->
        {heroImage && (
          <div class="card-tint rounded-r15 mb-10 overflow-hidden lg:hidden">
            <Image
              src={heroImage}
              alt={`Cover for ${title}`}
              width={800}
              densities={[1, 2]}
              quality={90}
              class="w-full object-cover"
              loading="eager"
              format="webp"
            />
          </div>
        )}
        <section id="blog-post-content" class="markdown-content">
          <slot />
        </section>

        <!-- related posts -->
        {relatedPosts.length > 0 && (
          <div class="stroke-tint mt-20 border-t pt-14">
            <p class="eyebrow text-muted-foreground">Keep reading</p>
            <h2 class="h2 text-foreground mt-6">Related posts</h2>
            <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {relatedPosts.map((relatedPost) => (
                <PostCard post={relatedPost} />
              ))}
            </div>
          </div>
        )}

        <!-- button to go back to all posts -->
        <div class="mt-14 flex">
          <Button variant="secondary" href="/blog">
            All posts
          </Button>
        </div>
      </div>

      <!-- hero + on this page on desktop -->
      <aside class="min-w-0" data-pagefind-ignore>
        {heroImage && (
          <div class="card-tint rounded-r15 mb-10 hidden overflow-hidden lg:block">
            <Image
              src={heroImage}
              alt={`Cover for ${title}`}
              width={400}
              densities={[1, 2]}
              quality={90}
              class="w-full object-cover"
              loading="eager"
              format="webp"
            />
          </div>
        )}
        <div class="lg:sticky lg:top-28">
          <TableOfContents headings={headings} headingIcons={post.data.tocHeadingIcons} />
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
