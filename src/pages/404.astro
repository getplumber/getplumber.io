---
import Button from "@components/Button/Button.astro";
import PageHeader from "@components/PageHeader/PageHeader.astro";
// main layout
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="404 - Page Not Found" description="Error 404 page not found." noindex={true}>
  <div class="site-container mt-24 mb-24 md:mt-36">
    <div class="card-tint rounded-r15 max-w-3xl p-8 md:p-12">
      <PageHeader
        eyebrow="Error 404"
        title="This page seems misplaced"
        lead="Unfortunately, this page does not exist. Maybe you can find what you're looking for on the home page?"
      >
        <div class="mt-2 flex">
          <Button variant="primary" href="/">
            Home
          </Button>
        </div>
      </PageHeader>
    </div>
  </div>
</BaseLayout>
