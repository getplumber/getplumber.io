---
import PageHeader from "@components/PageHeader/PageHeader.astro";
import { getAllArchivedReleasePosts } from "@js/blogUtils";
import { getLocaleFromUrl } from "@js/localeUtils";
import BaseLayout from "@layouts/BaseLayout.astro";
import BlogIndexLayout from "@layouts/BlogIndexLayout2.astro";

const currLocale = getLocaleFromUrl(Astro.url);
const archivedReleasePosts = await getAllArchivedReleasePosts(currLocale);
---

<BaseLayout
  title="R2Devops Release Archive"
  description="Archive of R2Devops product releases. The product has been renamed to Plumber and we're starting fresh with version 1.0.0."
>
  <div class="site-container mt-24 mb-24 md:mt-36">
    <PageHeader
      eyebrow="Archive"
      title="R2Devops release archive"
      lead="Release notes from when the platform was named R2Devops. The platform has been renamed to Plumber and restarted at version 1.0.0; these historical releases are kept here for reference."
    />
    <BlogIndexLayout posts={archivedReleasePosts} class="mt-14" />
  </div>
</BaseLayout>
