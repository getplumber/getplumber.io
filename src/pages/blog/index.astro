---
import PageHeader from "@components/PageHeader/PageHeader.astro";
import { getAllPosts } from "@js/blogUtils";
import { getLocaleFromUrl } from "@js/localeUtils";
import BaseLayout from "@layouts/BaseLayout.astro";
import BlogIndexLayout from "@layouts/BlogIndexLayout2.astro";

const currLocale = getLocaleFromUrl(Astro.url);
const posts = await getAllPosts(currLocale, true); // exclude archived posts (archive/)

const filterCategories = [
  "Customer Story",
  { id: "releases-platform", label: "Releases Platform" },
  { id: "releases-cli", label: "Releases CLI" },
  "Guide",
  "News",
];
---

<BaseLayout
  title="Plumber Blog - CI/CD Security & Pipeline Governance"
  description="Learn DevOps best practices for CI/CD security, pipeline governance, drift detection, and automated, secure deployments."
>
  <div class="site-container mt-24 mb-24 md:mt-36">
    <PageHeader
      eyebrow="Blog"
      title="Plumber blog"
      lead="Learn about CI/CD security, DevOps best practices, and governance guides to secure your pipelines."
    />
    <BlogIndexLayout posts={posts} filterCategories={filterCategories} class="mt-14" />
    <div class="mt-16 flex">
      <a
        href="/blog/archive"
        class="text-accent-text inline-flex items-center gap-2 text-base no-underline hover:underline"
      >
        R2Devops release archive
        <span class="subtitle-pixel" aria-hidden="true">
          &gt;
        </span>
      </a>
    </div>
  </div>
</BaseLayout>
