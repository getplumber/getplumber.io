---
/**
 * Error code documentation page.
 * Displays full details for a Plumber error code: description, impact,
 * remediation with before/after YAML examples.
 *
 * URL: https://getplumber.io/e/PLB-0101
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import { errorCodes, type ErrorCodeDoc } from "./_codes";

export function getStaticPaths() {
  return Object.entries(errorCodes).map(([code, doc]) => ({
    params: { code },
    props: doc,
  }));
}

type Props = ErrorCodeDoc;

const props = Astro.props;
const {
  code,
  title,
  category,
  severity,
  controlName,
  controlConfigKey,
  description,
  impact,
  remediation,
  badExample,
  badExampleCaption,
  goodExample,
  goodExampleCaption,
  tips,
  relatedCodes,
} = props;

const severityColors: Record<string, { bg: string; text: string; label: string }> = {
  critical: { bg: "bg-red-900/40", text: "text-red-400", label: "Critical" },
  high: { bg: "bg-orange-900/40", text: "text-orange-400", label: "High" },
  medium: { bg: "bg-yellow-900/40", text: "text-yellow-400", label: "Medium" },
  low: { bg: "bg-blue-900/40", text: "text-blue-400", label: "Low" },
};
const sev = severityColors[severity];

const allCodes = Object.keys(errorCodes);
const currentIndex = allCodes.indexOf(code);
const prevCode = currentIndex > 0 ? allCodes[currentIndex - 1] : null;
const nextCode = currentIndex < allCodes.length - 1 ? allCodes[currentIndex + 1] : null;
---

<BaseLayout
  title={`${code} — ${title} | Plumber Error Codes`}
  description={description}
  noindex={false}
>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav class="mb-8 text-sm" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-zinc-400">
        <li><a href="/docs/use-plumber/controls" class="hover:text-white transition-colors">Controls</a></li>
        <li class="text-zinc-600">/</li>
        <li><a href="/docs/use-plumber/controls" class="hover:text-white transition-colors">Error Codes</a></li>
        <li class="text-zinc-600">/</li>
        <li class="text-white font-medium">{code}</li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <span class="inline-flex items-center rounded-md bg-emerald-900/40 px-3 py-1 text-sm font-mono font-bold text-emerald-400 ring-1 ring-emerald-700/50">
          {code}
        </span>
        <span class={`inline-flex items-center rounded-md px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset ${sev.bg} ${sev.text} ring-current/20`}>
          {sev.label}
        </span>
        <span class="inline-flex items-center rounded-md bg-zinc-800 px-2.5 py-0.5 text-xs text-zinc-300 ring-1 ring-zinc-700">
          {category}
        </span>
      </div>
      <h1 class="text-3xl font-bold text-white sm:text-4xl">
        {title}
      </h1>
      <p class="mt-2 text-sm text-zinc-400">
        Control: <span class="text-zinc-300">{controlName}</span>
        · Config key: <code class="text-xs bg-zinc-800 px-1.5 py-0.5 rounded text-zinc-300">{controlConfigKey}</code>
      </p>
    </header>

    <!-- Description -->
    <section class="mb-8">
      <h2 class="text-xl font-semibold text-white mb-3 flex items-center gap-2">
        <span class="text-zinc-500">📋</span> What is this?
      </h2>
      <p class="text-zinc-300 leading-relaxed" set:html={description} />
    </section>

    <!-- Impact -->
    <section class="mb-8">
      <h2 class="text-xl font-semibold text-white mb-3 flex items-center gap-2">
        <span class="text-zinc-500">⚠️</span> Impact
      </h2>
      <div class={`rounded-lg border p-4 ${severity === "critical" ? "border-red-800/50 bg-red-950/20" : "border-yellow-800/50 bg-yellow-950/20"}`}>
        <p class="text-zinc-300 leading-relaxed" set:html={impact} />
      </div>
    </section>

    <!-- Remediation -->
    <section class="mb-8">
      <h2 class="text-xl font-semibold text-white mb-3 flex items-center gap-2">
        <span class="text-zinc-500">🔧</span> How to fix
      </h2>
      <p class="text-zinc-300 leading-relaxed mb-6">{remediation}</p>

      <!-- Bad example -->
      <div class="mb-6">
        <div class="flex items-center gap-2 mb-2">
          <span class="inline-flex items-center rounded px-2 py-0.5 text-xs font-medium bg-red-900/30 text-red-400 ring-1 ring-red-800/50">✗ Before</span>
          <span class="text-sm text-zinc-400">{badExampleCaption}</span>
        </div>
        <pre class="overflow-x-auto rounded-lg bg-zinc-900 p-4 text-sm leading-relaxed ring-1 ring-red-900/30"><code class="text-zinc-300">{badExample}</code></pre>
      </div>

      <!-- Good example -->
      <div class="mb-6">
        <div class="flex items-center gap-2 mb-2">
          <span class="inline-flex items-center rounded px-2 py-0.5 text-xs font-medium bg-emerald-900/30 text-emerald-400 ring-1 ring-emerald-800/50">✓ After</span>
          <span class="text-sm text-zinc-400">{goodExampleCaption}</span>
        </div>
        <pre class="overflow-x-auto rounded-lg bg-zinc-900 p-4 text-sm leading-relaxed ring-1 ring-emerald-900/30"><code class="text-zinc-300">{goodExample}</code></pre>
      </div>
    </section>

    <!-- Tips -->
    {tips.length > 0 && (
      <section class="mb-8">
        <h2 class="text-xl font-semibold text-white mb-3 flex items-center gap-2">
          <span class="text-zinc-500">💡</span> Tips
        </h2>
        <ul class="space-y-2">
          {tips.map((tip) => (
            <li class="flex items-start gap-2 text-zinc-300">
              <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-emerald-500" />
              <span set:html={tip} />
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Configuration -->
    <section class="mb-8">
      <h2 class="text-xl font-semibold text-white mb-3 flex items-center gap-2">
        <span class="text-zinc-500">⚙️</span> Configuration
      </h2>
      <p class="text-zinc-300 mb-3">
        This control is configured in <code class="text-xs bg-zinc-800 px-1.5 py-0.5 rounded text-zinc-300">.plumber.yaml</code> under the key:
      </p>
      <pre class="overflow-x-auto rounded-lg bg-zinc-900 p-4 text-sm ring-1 ring-zinc-800"><code class="text-zinc-300">{`controls:\n  ${controlConfigKey}:\n    enabled: true`}</code></pre>
      <p class="mt-3 text-sm text-zinc-400">
        See the <a href="/docs/cli" class="text-emerald-400 hover:text-emerald-300 underline">CLI documentation</a> for the full configuration reference.
      </p>
    </section>

    <!-- Related codes -->
    {relatedCodes.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-semibold text-white mb-3 flex items-center gap-2">
          <span class="text-zinc-500">🔗</span> Related error codes
        </h2>
        <div class="flex flex-wrap gap-2">
          {relatedCodes.map((rc) => {
            const related = errorCodes[rc];
            return related ? (
              <a
                href={`/e/${rc}`}
                class="inline-flex items-center gap-2 rounded-lg bg-zinc-800 px-3 py-2 text-sm ring-1 ring-zinc-700 hover:ring-emerald-700 hover:bg-zinc-700 transition-all"
              >
                <span class="font-mono font-bold text-emerald-400">{rc}</span>
                <span class="text-zinc-400">{related.title}</span>
              </a>
            ) : null;
          })}
        </div>
      </section>
    )}

    <!-- Navigation -->
    <nav class="flex items-center justify-between border-t border-zinc-800 pt-6" aria-label="Error codes navigation">
      {prevCode ? (
        <a href={`/e/${prevCode}`} class="flex items-center gap-2 text-sm text-zinc-400 hover:text-white transition-colors">
          <span>←</span>
          <span class="font-mono">{prevCode}</span>
        </a>
      ) : <span />}
      <a href="/docs/use-plumber/controls" class="text-sm text-emerald-400 hover:text-emerald-300 transition-colors">
        All Controls →
      </a>
      {nextCode ? (
        <a href={`/e/${nextCode}`} class="flex items-center gap-2 text-sm text-zinc-400 hover:text-white transition-colors">
          <span class="font-mono">{nextCode}</span>
          <span>→</span>
        </a>
      ) : <span />}
    </nav>
  </div>
</BaseLayout>
