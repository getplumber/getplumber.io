---
import CliVsPlatform from "@components/Feature/CliVsPlatform.astro";
import PlumberQuickStart from "@components/Feature/PlumberQuickStart.astro";
import PlumberRadar from "@components/Feature/PlumberRadar.astro";
import TheLoop from "@components/Feature/TheLoop.astro";
import WhyCicdSecurity from "@components/Feature/WhyCicdSecurity.astro";
import PlumberHero from "@components/Hero/PlumberHero.astro";
import SectionNav from "@components/Nav/SectionNav.astro";
import PricingHome from "@components/Pricing/PricingHome.astro";
import SectionDivider from "@components/SectionDivider/SectionDivider.astro";
import LogoCloud2 from "@components/LogoCloud/LogoCloud2.astro";
import Testimonials2 from "@components/Testimonials/Testimonials2.astro";
import FaqSection from "@components/Faq/FaqSection.astro";
import SoftwareAppJsonLd from "@components/Seo/SoftwareAppJsonLd.astro";
import { faqData } from "@config/en/faqData.json";
import { getLocaleFromUrl } from "@js/localeUtils";
import { getTranslatedData } from "@js/translationUtils";
import BaseLayout from "@layouts/BaseLayout.astro";

const currLocale = getLocaleFromUrl(Astro.url);
const siteData = getTranslatedData("siteData", currLocale);

const pageTitle = siteData.homepageTitle ?? siteData.title;
const pageDescription = siteData.homepageDescription ?? siteData.description;

// Floating right-side section nav (scroll-spy)
const pageSections = [
  { id: "why-security", label: "Why it matters" },
  { id: "the-loop", label: "How it works" },
  { id: "platform", label: "CLI & Platform" },
  { id: "plumber-radar", label: "Radar" },
  { id: "pricing", label: "Pricing" },
  { id: "testimonials", label: "Testimonials" },
  { id: "plumber-cta", label: "Quick start" },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SoftwareAppJsonLd />
  <!-- .sections-alternate: children marked .section-alt alternate the subtle
       background band automatically (see global.css) — reorder freely -->
  <div class="sections-alternate">
    <!-- hero + logo strip form one visual unit, so they share one alternation slot -->
    <div class="section-alt">
      <PlumberHero />
      <LogoCloud2 />
    </div>
    <!-- <WhyCicdSecurity /> -->
    <TheLoop />
    <CliVsPlatform />
    <PlumberRadar />
    <PricingHome />
    <Testimonials2 />
    <PlumberQuickStart />
    <FaqSection items={faqData} heading="Frequently asked questions" id="faq" />
    <SectionNav sections={pageSections} />
  </div>
</BaseLayout>
