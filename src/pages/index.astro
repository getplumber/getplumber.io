---
import AttackersWalkIn from "@components/Home/AttackersWalkIn.astro";
import BookDemo from "@components/Home/BookDemo.astro";
import Faq from "@components/Home/Faq.astro";
import Hero from "@components/Home/Hero.astro";
import HowItWorks from "@components/Home/HowItWorks.astro";
import IncidentLog from "@components/Home/IncidentLog.astro";
import OneProduct from "@components/Home/OneProduct.astro";
import Proof from "@components/Home/Proof.astro";
import ValueProp from "@components/Home/ValueProp.astro";
import SoftwareAppJsonLd from "@components/Seo/SoftwareAppJsonLd.astro";
import { getLocaleFromUrl } from "@js/localeUtils";
import { getTranslatedData } from "@js/translationUtils";
import BaseLayout from "@layouts/BaseLayout.astro";

const currLocale = getLocaleFromUrl(Astro.url);
const siteData = getTranslatedData("siteData", currLocale);

const pageTitle = siteData.homepageTitle ?? siteData.title;
const pageDescription = siteData.homepageDescription ?? siteData.description;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SoftwareAppJsonLd />
  <Hero />
  <ValueProp />
  <AttackersWalkIn />
  <IncidentLog />
  <HowItWorks />
  <OneProduct />
  <Proof />
  <Faq />
  <BookDemo />
</BaseLayout>
