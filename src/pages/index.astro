---
import AttackersWalkIn from "@components/Home/AttackersWalkIn.astro";
import BookDemo from "@components/Home/BookDemo.astro";
import Faq from "@components/Home/Faq.astro";
import Hero from "@components/Home/Hero.astro";
import HowItWorks from "@components/Home/HowItWorks.astro";
import IncidentLog from "@components/Home/IncidentLog.astro";
import OneProduct from "@components/Home/OneProduct.astro";
import Proof from "@components/Home/Proof.astro";
import ValueProp from "@components/Home/ValueProp.astro";
import SoftwareAppJsonLd from "@components/Seo/SoftwareAppJsonLd.astro";
import { getLocaleFromUrl } from "@js/localeUtils";
import { getTranslatedData } from "@js/translationUtils";
import BaseLayout from "@layouts/BaseLayout.astro";

const currLocale = getLocaleFromUrl(Astro.url);
const siteData = getTranslatedData("siteData", currLocale);

const pageTitle = siteData.homepageTitle ?? siteData.title;
const pageDescription = siteData.homepageDescription ?? siteData.description;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SoftwareAppJsonLd />
  <Hero />
  <ValueProp />
  <AttackersWalkIn />
  <IncidentLog />
  <HowItWorks />
  <OneProduct />
  <Proof />
  <Faq />
  <BookDemo />
</BaseLayout>

<script>
  /**
   * Reveal home sections as they scroll into view (review of 2026-10-27). Elements with
   * data-reveal fade in as a block; the children of a data-reveal-stagger element fade in
   * one after the other through the --i custom property. The html class gates the hidden
   * state so nothing stays invisible without JavaScript. Elements with data-hover-reveal
   * carry the is-in-view class while they are in the viewport: on tablets and phones the
   * components play their hover states from it (the attribute value is the threshold).
   */
  const observers: IntersectionObserver[] = [];

  function initReveal() {
    // observers of the previous page (view transitions) stop here
    observers.splice(0).forEach((old) => old.disconnect());
    const targets = document.querySelectorAll<HTMLElement>("[data-reveal], [data-reveal-stagger]");
    const hoverTargets = document.querySelectorAll<HTMLElement>("[data-hover-reveal]");
    if (!targets.length && !hoverTargets.length) return;
    document.documentElement.classList.add("reveal-ready");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: "0px 0px -12% 0px", threshold: 0.05 },
    );
    observers.push(observer);
    targets.forEach((target) => {
      if (target.hasAttribute("data-reveal-stagger")) {
        Array.from(target.children).forEach((child, i) => {
          (child as HTMLElement).style.setProperty("--i", String(i));
        });
      }
      observer.observe(target);
    });

    const byThreshold = new Map<number, IntersectionObserver>();
    hoverTargets.forEach((target) => {
      const given = parseFloat(target.dataset.hoverReveal || "");
      const threshold = Number.isFinite(given) ? Math.min(1, Math.max(0, given)) : 0.5;
      let hoverObserver = byThreshold.get(threshold);
      if (!hoverObserver) {
        hoverObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              entry.target.classList.toggle("is-in-view", entry.isIntersecting);
            });
          },
          { rootMargin: "-10% 0px -10% 0px", threshold },
        );
        byThreshold.set(threshold, hoverObserver);
        observers.push(hoverObserver);
      }
      hoverObserver.observe(target);
    });
  }

  initReveal();
  document.addEventListener("astro:after-swap", initReveal);
</script>
